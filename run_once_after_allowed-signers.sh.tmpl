#!/usr/bin/env bash
# vi: set ft=bash
# Derive ~/.allowed_signers from the signing keys on GitHub, so every
# machine verifies every other machine's signature. The list only changes
# when a machine registers a signing key, so chezmoi runs this once for each
# version of its rendered content; re-run it on demand after registering one.
# A run that cannot reach GitHub fails, so the next apply retries it.
set -euo pipefail

out="$HOME/.allowed_signers"
if ! command -v jq >/dev/null 2>&1; then
	echo 'error: jq is not installed; cannot derive ~/.allowed_signers; install jq and run chezmoi apply' >&2
	exit 1
fi
keys=$(curl -fsS --max-time 10 "https://api.github.com/users/{{ .githubAccount }}/ssh_signing_keys" \
	| jq -r '.[].key') || { echo 'error: GitHub API unavailable; cannot derive ~/.allowed_signers; run chezmoi apply when online' >&2; exit 1; }
if [ -z "$keys" ]; then
	echo 'error: GitHub returned no signing keys; cannot derive ~/.allowed_signers' >&2
	exit 1
fi

tmp="$(mktemp)"
while IFS= read -r key; do
	printf '{{ .gitEmail }} %s\n' "$key"
done <<<"$keys" > "$tmp"

if [ -f "$out" ] && cmp -s "$tmp" "$out"; then
	rm -f "$tmp"
	exit 0
fi
mv "$tmp" "$out"
echo '>allowed_signers updated'
