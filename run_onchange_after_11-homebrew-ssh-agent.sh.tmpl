{{ if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
# vi: set ft=bash
# Reload the agent so launchd picks up a changed plist or wrapper. The
# includes below hash both, so the reload happens only when one of them or
# this script changes; RunAtLoad and KeepAlive cover login and crash.
# {{ include "Library/LaunchAgents/systems.terroir.homebrew-ssh-agent.plist" | sha256sum }}
# {{ include "dot_bin/executable_homebrew-ssh-agent" | sha256sum }}
set -euo pipefail

domain="gui/$(id -u)"
label="systems.terroir.homebrew-ssh-agent"
plist="$HOME/Library/LaunchAgents/$label.plist"

# bootout is asynchronous: re-bootstrapping a label launchd is still
# tearing down fails with "Bootstrap failed: 5: Input/output error".
launchctl bootout "$domain/$label" 2>/dev/null || true
for _ in {1..50}; do
	launchctl print "$domain/$label" >/dev/null 2>&1 || break
	sleep 0.1
done
launchctl bootstrap "$domain" "$plist"
{{ end -}}
