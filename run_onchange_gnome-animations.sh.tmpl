{{ if and (eq .chezmoi.os "linux") .desktop .vm (not .transient) -}}
#!/usr/bin/env bash
# vi: set ft=bash
set -euo pipefail

# VMs run without hardware GPU acceleration (virtio-gpu-pci), so disable
# GNOME animations via a system dconf default. No user session is needed,
# and a user's own explicit setting still wins.
keyfile="$(mktemp)"
trap 'rm -f "$keyfile"' EXIT
cat > "$keyfile" <<'EOF'
[org/gnome/desktop/interface]
enable-animations=false
EOF

sudo install -o root -g root -m 0644 "$keyfile" \
	/etc/dconf/db/local.d/00-gnome-animations
sudo dconf update
{{ end -}}
