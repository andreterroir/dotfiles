{{- if ne .chezmoi.os "linux" -}}
{{- fail (printf "this repository manages Linux only; %s is not supported" .chezmoi.os) -}}
{{- end -}}
{{- $vm := false -}}
{{- if hasKey . "vm" -}}
    {{- $vm = .vm -}}
{{- else -}}
    {{- $vm = eq (output "sh" "-c" "systemd-detect-virt --vm --quiet 2>/dev/null && echo true || true" | trim) "true" -}}
{{- end -}}
{{- $desktop := ne (lookPath "gnome-shell") "" -}}
{{- $keepass := and $desktop (not $vm) -}}
sourceDir = "{{ .chezmoi.sourceDir }}"

[edit]
    apply = true
[merge]
    command = "vim"
    args = ["-d", "{{ "{{ .Destination }}" }}", "{{ "{{ .Source }}" }}", "{{ "{{ .Target }}" }}"]
[data]
    vm = {{ $vm }}
    keepass = {{ $keepass }}
    desktop = {{ $desktop }}
    server = {{ not $desktop }}
