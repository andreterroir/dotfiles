{{- $vm := false -}}
{{- if hasKey . "vm" -}}
    {{- $vm = .vm -}}
{{- else if eq .chezmoi.os "linux" -}}
    {{- $vm = eq (output "sh" "-c" "systemd-detect-virt --vm --quiet 2>/dev/null && echo true || true" | trim) "true" -}}
{{- end -}}
{{- $container := false -}}
{{- if eq .chezmoi.os "linux" -}}
    {{- $container = eq (output "sh" "-c" "systemd-detect-virt --container --quiet 2>/dev/null && echo true || true" | trim) "true" -}}
{{- end -}}
{{- $desktop := ne (lookPath "gnome-shell") "" -}}
{{- $distro := "" -}}
{{- if eq .chezmoi.os "linux" -}}
    {{- $distro = .chezmoi.osRelease.id -}}
{{- end -}}
{{- $host := lower (trimSuffix ".local" .chezmoi.hostname) -}}
{{- $known := false -}}
{{- if stat (joinPath .chezmoi.sourceDir ".chezmoidata.toml") -}}
    {{- $data := fromToml (include ".chezmoidata.toml") -}}
    {{- if hasKey $data "managedHosts" -}}
        {{- $known = has $host $data.managedHosts -}}
    {{- end -}}
{{- end -}}
{{- $transient := or $container (ne (env "AMP_ORB") "") (not $known) -}}
{{- $profile := "transient" -}}
{{- if not $transient -}}
    {{- if eq $host "greenhouse" -}}
        {{- $profile = "devserver" -}}
    {{- else if $desktop -}}
        {{- $profile = "desktop" -}}
    {{- end -}}
{{- end -}}
sourceDir = "{{ .chezmoi.sourceDir }}"

[edit]
    apply = true
[merge]
    command = "vim"
    args = ["-d", "{{ "{{ .Destination }}" }}", "{{ "{{ .Source }}" }}", "{{ "{{ .Target }}" }}"]
[data]
    distro = "{{ $distro }}"
    vm = {{ $vm }}
    desktop = {{ eq $profile "desktop" }}
    devserver = {{ eq $profile "devserver" }}
    transient = {{ eq $profile "transient" }}
