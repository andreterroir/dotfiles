{{- $vm := false -}}
{{- if hasKey . "vm" -}}
    {{- $vm = .vm -}}
{{- else if eq .chezmoi.os "linux" -}}
    {{- $vm = eq (output "sh" "-c" "systemd-detect-virt --vm --quiet 2>/dev/null && echo true || true" | trim) "true" -}}
{{- end -}}
{{- $container := false -}}
{{- $container = eq (output "sh" "-c" "systemd-detect-virt --container --quiet 2>/dev/null && echo true || true" | trim) "true" -}}
{{- $desktop := or (eq .chezmoi.os "darwin") (ne (lookPath "gnome-shell") "") -}}
{{- $known := false -}}
{{- $dataFile := joinPath .chezmoi.sourceDir ".chezmoidata.toml" -}}
{{- if stat $dataFile -}}
    {{- $data := fromToml (output "cat" $dataFile) -}}
    {{- if hasKey $data "managedHosts" -}}
        {{- $host := lower (trimSuffix ".local" .chezmoi.hostname) -}}
        {{- $known = has $host $data.managedHosts -}}
    {{- end -}}
{{- end -}}
{{- $transient := false -}}
{{- $signal := lower (env "CHEZMOI_TRANSIENT") -}}
{{- if eq $signal "" -}}
    {{- $transient = or $container (not $known) -}}
{{- else if not (or (eq $signal "0") (eq $signal "false")) -}}
    {{- $transient = true -}}
{{- end -}}
sourceDir = "{{ .chezmoi.sourceDir }}"

[edit]
    apply = true
[merge]
    command = "vim"
    args = ["-d", "{{ "{{ .Destination }}" }}", "{{ "{{ .Source }}" }}", "{{ "{{ .Target }}" }}"]
[data]
    vm = {{ $vm }}
    desktop = {{ $desktop }}
    linux.desktop = {{ and $desktop (eq .chezmoi.os "linux") }}
    server = {{ not $desktop }}
    transient = {{ $transient }}
