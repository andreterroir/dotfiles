{{ if eq .chezmoi.os "linux" -}}
{{   if and .server (eq .chezmoi.osRelease.id "ubuntu") -}}
#!/usr/bin/env bash
# vi: set ft=bash
# Install Ghostty's own xterm-ghostty terminfo entry into ~/.terminfo.
#
# Ubuntu's ncurses-term only ships a reduced entry named "ghostty", which is
# not a drop-in replacement for Ghostty's xterm-ghostty entry.
set -euo pipefail

if infocmp -x xterm-ghostty > /dev/null 2>&1; then
	echo '>xterm-ghostty terminfo already available'
	exit 0
fi

echo '>installing bundled xterm-ghostty terminfo'
tic -x -o "$HOME/.terminfo" \
	"$CHEZMOI_SOURCE_DIR/assets/xterm-ghostty.terminfo"

infocmp -x xterm-ghostty > /dev/null
echo '>xterm-ghostty terminfo installed'
{{   end -}}
{{ end -}}
