{{ if eq .chezmoi.os "darwin" -}}
IgnoreUnknown UseKeychain
{{ end -}}
Include ~/.ssh/local_config
{{- if eq .chezmoi.os "darwin" }}
Include ~/.colima/ssh_config
{{- end }}
Host *
	AddKeysToAgent yes
	{{- if eq .chezmoi.os "darwin" }}
	UseKeychain yes
	{{- end }}
	HashKnownHosts no
	IdentityFile none

{{ if .vm -}}
Host github.com git.terroir.systems chalon
	IdentityFile ~/.ssh/id_ed25519_sk
	IdentityFile ~/.ssh/identities/yubikey-1
	IdentityFile ~/.ssh/identities/yubikey-2
	IdentitiesOnly yes

Host github.com
	IdentityFile ~/.ssh/id_ed25519
{{ else -}}
Host github.com git.terroir.systems chalon
	IdentityFile ~/.ssh/id_ed25519_sk

{{- if .desktop }}
	IdentitiesOnly yes
{{- if eq .chezmoi.hostname "x1" }}
	# x1's machine key is an intentional authentication fallback.
	IdentityFile ~/.ssh/id_ed25519
{{- end }}
{{- end }}
{{- end }}
