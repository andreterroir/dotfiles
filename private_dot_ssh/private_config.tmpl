{{ if eq .chezmoi.os "darwin" -}}
IgnoreUnknown UseKeychain
{{ end -}}
Include ~/.ssh/local_config
{{- if eq .chezmoi.os "darwin" }}
Include ~/.colima/ssh_config
{{- end }}
Host *
	AddKeysToAgent yes
	{{- if eq .chezmoi.os "darwin" }}
	UseKeychain yes
	{{- end }}
	HashKnownHosts no
	IdentityFile none

Host github.com git.terroir.systems
	IdentityFile ~/.ssh/id_ed25519_sk

{{- if .desktop }}
	IdentitiesOnly yes
{{- if eq .chezmoi.hostname "x1" }}
	# x1's machine key is an intentional authentication fallback.
	IdentityFile ~/.ssh/id_ed25519
{{- end }}
{{- end }}
