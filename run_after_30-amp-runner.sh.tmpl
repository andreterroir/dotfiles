{{- $transient := false -}}
{{- if hasKey . "transient" -}}
    {{- $transient = .transient -}}
{{- end -}}
{{ if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
# vi: set ft=bash
# Run the Amp runner that serves ~/code on every Linux machine, so
# threads can be created on it from ampcode.com. Linger starts the user
# manager, and so the runner, at boot rather than at login.
# An apply restarts the runner only when its unit, the installed binary, or
# Amp's settings changed; otherwise it starts the runner if it is stopped and
# leaves running threads alone.
set -euo pipefail
{{ if $transient }}echo '>transient profile: Amp runner setup is disabled' >&2
exit 0
{{ else }}
amp="$HOME/.local/bin/amp"
unit="$HOME/.config/systemd/user/amp-runner.service"
settings="$HOME/.config/amp/settings.json"
state_file="$HOME/.local/state/amp-runner/fingerprint"

if [ ! -x "$amp" ]; then
	echo '>amp-runner: amp is not installed; skipping' >&2
	exit 0
fi

loginctl enable-linger "$(id -un)" >/dev/null 2>&1 || true

if ! systemctl --user daemon-reload 2>/dev/null; then
	echo '>amp-runner: no systemd user manager; run chezmoi apply from a session' >&2
	exit 0
fi

unit_hash="$(sha256sum "$unit" | cut -d' ' -f1)"
binary_hash="$(sha256sum "$amp" | cut -d' ' -f1)"
settings_hash=missing
if [ -f "$settings" ]; then
    settings_hash="$(sha256sum "$settings" | cut -d' ' -f1)"
fi
state="$(cat "$state_file" 2>/dev/null || true)"
state_unit=""
state_binary=""
state_settings=""
if [ -n "$state" ]; then
    read -r state_unit state_binary state_settings <<<"$state"
fi

# The runner's own auto-update replaces the binary and restarts into it when
# idle, so an apply after that must not restart it again.
running_binary_hash() {
	local pid
	pid="$(systemctl --user show --property=MainPID --value \
		amp-runner.service 2>/dev/null)"
	[ -n "$pid" ] && [ "$pid" != 0 ] || return 0
	sha256sum "/proc/$pid/exe" 2>/dev/null | cut -d' ' -f1 || true
}

systemctl --user enable amp-runner.service

if { [ "$state_unit" = "$unit_hash" ] &&
    [ "$state_binary" = "$binary_hash" ] &&
    [ "$state_settings" = "$settings_hash" ]; } ||
	! systemctl --user is-active --quiet amp-runner.service; then
	systemctl --user start amp-runner.service
elif [ "$state_unit" = "$unit_hash" ] &&
    [ "$state_settings" = "$settings_hash" ] &&
	[ "$(running_binary_hash)" = "$binary_hash" ]; then
	echo '>amp-runner: runner already runs the installed binary and settings' >&2
else
	echo '>amp-runner: unit, binary, or settings changed; restarting' >&2
	systemctl --user restart amp-runner.service
fi

mkdir -p "$(dirname "$state_file")"
printf '%s %s %s\n' "$unit_hash" "$binary_hash" "$settings_hash" >"$state_file"
{{ end -}}
{{ end -}}
