{{ if .desktop -}}
#!/usr/bin/env bash
# vi: set ft=bash
# This script is interactive: it blocks for the PIV PIN, the YubiKey
# touch (when touch-policy is set), and the `gh auth login --web`
# browser flow. Re-runs are idempotent: a YubiKey is only requested
# when the local ed25519 is not yet authorised on netcup; GitHub key
# presence is checked via the public API (no auth needed), so gh
# auth only runs when a key still needs uploading. Uploads pin gh's
# active account to andreterroir (left active afterwards). The key
# is registered as both authentication and signing.
# `~/.allowed_signers` is owned by chezmoi; this script only adds
# the new line to the repo's `dot_allowed_signers` and commits it.
# Run from a real terminal, not from CI.
set -euo pipefail

# Switch the chezmoi source remote to SSH after initial HTTPS-based init
git -C "$CHEZMOI_SOURCE_DIR" remote set-url origin git@github.com:andreterroir/dotfiles.git

LOCAL_KEY="$HOME/.ssh/id_ed25519"
LOCAL_PUB="$LOCAL_KEY.pub"
NETCUP=REDACTED
{{- if eq .chezmoi.os "darwin" }}
PKCS11=/opt/homebrew/lib/libykcs11.dylib
{{- else }}
PKCS11=/usr/lib64/libykcs11.so.2
{{- end }}

# --- 1. local key
if [ ! -f "$LOCAL_KEY" ] || [ ! -f "$LOCAL_PUB" ]; then
	echo '>generating per-machine ed25519 key'
	ssh-keygen -t ed25519 -C "$(hostname -s) $(date +%Y-%m-%d)" -f "$LOCAL_KEY"
fi

# --- 2. REDACTED
# PKCS11Provider is passed inline via ssh-copy-id -o, not kept in the
# permanent SSH config: a permanent PKCS11Provider disables UseKeychain
# on macOS, forcing the ed25519 passphrase to be re-entered after every
# reboot. The PIV cert acts as a fallback identity until the per-machine
# ed25519 is registered.
# -i + IdentitiesOnly probes the local key alone (no PIV, no agent), so
# the probe works without a YubiKey plugged in.
if ssh -i "$LOCAL_KEY" -o IdentitiesOnly=yes "$NETCUP" true 2>/dev/null; then
	echo '>local key already authorised on REDACTED'
else
	if ! ykman piv info >/dev/null 2>&1; then
		read -rp ">plug in YubiKey and press Enter"
	fi
	# -f skips the macOS launchd-ssh-agent quirk in ssh-copy-id's "is
	# this key already installed?" probe (we already checked above).
	echo '>authorising local key on REDACTED'
	ssh-copy-id -f -i "$LOCAL_PUB" -o "PKCS11Provider=$PKCS11" "$NETCUP"
fi

# --- 3. GitHub (andreterroir)
# Key registrations are public, so check them before touching gh
# auth: re-runs skip the browser flow when nothing needs uploading.
# Key material never appears in titles, so a substring match on the
# buffered JSON is enough (buffering also avoids curl|grep SIGPIPE
# false-negatives under pipefail).
GH_ACCOUNT=andreterroir
KEY_MAT=$(awk '{print $1, $2}' "$LOCAL_PUB")
auth_keys=$(curl -fsS "https://api.github.com/users/${GH_ACCOUNT}/keys")
signing_keys=$(curl -fsS "https://api.github.com/users/${GH_ACCOUNT}/ssh_signing_keys")

if ! grep -qF "$KEY_MAT" <<<"$auth_keys" || ! grep -qF "$KEY_MAT" <<<"$signing_keys"; then
	# gh may hold several accounts (work + personal): make
	# $GH_ACCOUNT active so refresh/add never hit another login.
	# Switch works when the account is known, log in otherwise.
	if gh auth switch --hostname github.com --user "$GH_ACCOUNT" 2>/dev/null; then
		echo ">using GitHub account ${GH_ACCOUNT}"
	else
		echo ">logging in to GitHub as ${GH_ACCOUNT} (select this account in the browser)"
		gh auth login --hostname github.com --git-protocol ssh --web \
			--scopes admin:public_key --scopes admin:ssh_signing_key \
			--skip-ssh-key
	fi
	active=$(gh api user -q .login)
	if [ "$active" != "$GH_ACCOUNT" ]; then
		echo "error: active GitHub account is not ${GH_ACCOUNT}" >&2
		exit 1
	fi

	# Login requests both scopes, so a token created by this script
	# has public_key iff it has the signing scope; only older
	# tokens need topping up.
	if ! grep -qF admin:ssh_signing_key \
		<<<"$(gh auth status --hostname github.com --active 2>&1)"; then
		echo '>extending GitHub token scopes'
		gh auth refresh --hostname github.com \
			--scopes admin:public_key --scopes admin:ssh_signing_key
	fi

	title="$(whoami)@$(hostname -s)"
	if ! grep -qF "$KEY_MAT" <<<"$auth_keys"; then
		echo '>registering local key on GitHub'
		gh ssh-key add "$LOCAL_PUB" --title "$title"
	fi
	if ! grep -qF "$KEY_MAT" <<<"$signing_keys"; then
		echo '>registering local signing key on GitHub'
		gh ssh-key add "$LOCAL_PUB" --title "$title" --type signing
	fi
else
	echo '>local key already on GitHub (auth + signing)'
fi

# --- 4. update allowed signers + commit
if grep -qF "$(awk '{print $2}' "$LOCAL_PUB")" "$CHEZMOI_SOURCE_DIR/dot_allowed_signers"; then
	echo '>dot_allowed_signers already has this key'
else
	PUB_LINE=$(awk '{print $1, $2}' "$LOCAL_PUB")
	git_email=$(git config --get user.email)
	echo "$git_email $PUB_LINE @$(hostname -s)" >> "$CHEZMOI_SOURCE_DIR/dot_allowed_signers"
	git -C "$CHEZMOI_SOURCE_DIR" add dot_allowed_signers
	git -C "$CHEZMOI_SOURCE_DIR" commit --only dot_allowed_signers \
		-m "Allow $(hostname -s) signing key" \
		-m "Auto-generated by run_once_set-up-3-ssh.sh on $(hostname -s) at $(date -Iseconds)."
fi
{{ end -}}
