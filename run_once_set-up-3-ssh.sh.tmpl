{{ if .desktop -}}
#!/usr/bin/env bash
# vi: set ft=bash
# This script is interactive: it blocks for the PIV PIN, the YubiKey
# touch (when touch-policy is set), and the `gh auth login --web`
# browser flow. Re-runs are idempotent: a YubiKey is only requested
# when the local ed25519 is not yet authorised on netcup; GitHub key
# presence is checked via the public API for the andreterroir account
# (no elevated scopes), and login/scope refresh only runs when a key
# still needs uploading. The key is registered on GitHub as both
# authentication and signing. `~/.allowed_signers` is owned by
# chezmoi; this script only adds the new line to the repo's
# `dot_allowed_signers` and commits it.
# Run from a real terminal, not from CI.
set -euo pipefail

# Switch the chezmoi source remote to SSH after initial HTTPS-based init
git -C "$CHEZMOI_SOURCE_DIR" remote set-url origin git@github.com:andreterroir/dotfiles.git

LOCAL_KEY="$HOME/.ssh/id_ed25519"
LOCAL_PUB="$LOCAL_KEY.pub"
NETCUP=REDACTED

# --- 1. local key
if [ ! -f "$LOCAL_KEY" ] || [ ! -f "$LOCAL_PUB" ]; then
	echo '>generating per-machine ed25519 key'
	ssh-keygen -t ed25519 -C "$(hostname -s) $(date +%Y-%m-%d)" -f "$LOCAL_KEY"
fi

# --- 2. REDACTED
# The SSH config provides PKCS11Provider for this host, so the PIV
# cert is available as a fallback identity for the bootstrap case
# where the per-machine ed25519 is not yet registered.
# -i + IdentitiesOnly probes the local key in isolation (no PIV, no
# agent), so the probe works without a YubiKey plugged in; the
# passphrase is prompted for interactively.
if ssh -i "$LOCAL_KEY" -o IdentitiesOnly=yes "$NETCUP" true 2>/dev/null; then
	echo '>local key already authorised on REDACTED'
else
	if ! ykman piv info >/dev/null 2>&1; then
		read -rp ">plug in YubiKey and press Enter"
	fi
	# -f skips the macOS launchd-ssh-agent quirk in ssh-copy-id's "is
	# this key already installed?" probe (we already checked above).
	echo '>authorising local key on REDACTED'
	ssh-copy-id -f -i "$LOCAL_PUB" "$NETCUP"
fi

# --- 3. GitHub (andreterroir)
# Public user-key endpoints need no scopes, so we can skip gh auth
# entirely when the key is already registered on the target account.
GH_ACCOUNT=andreterroir
KEY_MAT=$(awk '{print $1, $2}' "$LOCAL_PUB")
# Buffer the response before grepping: with pipefail, curl|grep -q can
# false-negative when grep exits early and curl dies on SIGPIPE.
need_auth_key=false
need_signing_key=false
auth_keys_json=$(curl -fsS "https://api.github.com/users/${GH_ACCOUNT}/keys")
if grep -qF "\"key\": \"$KEY_MAT\"" <<<"$auth_keys_json"; then
	echo ">local key already on GitHub (@${GH_ACCOUNT})"
else
	need_auth_key=true
fi
signing_keys_json=$(curl -fsS "https://api.github.com/users/${GH_ACCOUNT}/ssh_signing_keys")
if grep -qF "\"key\": \"$KEY_MAT\"" <<<"$signing_keys_json"; then
	echo ">local signing key already on GitHub (@${GH_ACCOUNT})"
else
	need_signing_key=true
fi

if $need_auth_key || $need_signing_key; then
	needed_scopes=()
	$need_auth_key && needed_scopes+=(admin:public_key)
	$need_signing_key && needed_scopes+=(admin:ssh_signing_key)

	# Pin the active account so refresh/add never hit a different login.
	# Login makes the new account active; switch only when it already exists.
	if gh auth status --hostname github.com 2>&1 \
		| grep -qF "account ${GH_ACCOUNT} "; then
		echo ">using GitHub account ${GH_ACCOUNT}"
		gh auth switch --hostname github.com --user "$GH_ACCOUNT"
	else
		echo ">logging in to GitHub as ${GH_ACCOUNT} (select this account in the browser)"
		scope_flags=()
		for s in "${needed_scopes[@]}"; do
			scope_flags+=(--scopes "$s")
		done
		gh auth login \
			--hostname github.com \
			--git-protocol ssh \
			--web \
			"${scope_flags[@]}" \
			--skip-ssh-key
	fi
	active=$(gh api user -q .login)
	if [ "$active" != "$GH_ACCOUNT" ]; then
		echo "error: expected GitHub login ${GH_ACCOUNT}, got ${active}" >&2
		exit 1
	fi

	# Refresh only scopes the active token still lacks.
	auth_status=$(gh auth status --hostname github.com --active 2>&1)
	missing_scopes=()
	for s in "${needed_scopes[@]}"; do
		grep -qF "$s" <<<"$auth_status" || missing_scopes+=("$s")
	done
	if ((${#missing_scopes[@]})); then
		echo ">extending GitHub token scopes: ${missing_scopes[*]}"
		scope_flags=()
		for s in "${missing_scopes[@]}"; do
			scope_flags+=(-s "$s")
		done
		gh auth refresh -h github.com "${scope_flags[@]}"
	fi

	title="$(whoami)@$(hostname -s)"
	if $need_auth_key; then
		echo '>registering local key on GitHub'
		gh ssh-key add "$LOCAL_PUB" --title "$title"
	fi
	if $need_signing_key; then
		echo '>registering local signing key on GitHub'
		gh ssh-key add "$LOCAL_PUB" --title "$title" --type signing
	fi
fi

# --- 4. update allowed signers + commit
if grep -qF "$(awk '{print $2}' "$LOCAL_PUB")" "$CHEZMOI_SOURCE_DIR/dot_allowed_signers"; then
	echo '>dot_allowed_signers already has this key'
else
	PUB_LINE=$(awk '{print $1, $2}' "$LOCAL_PUB")
	git_email=$(git config --get user.email)
	echo "$git_email $PUB_LINE @$(hostname -s)" >> "$CHEZMOI_SOURCE_DIR/dot_allowed_signers"
	git -C "$CHEZMOI_SOURCE_DIR" add dot_allowed_signers
	git -C "$CHEZMOI_SOURCE_DIR" commit --only dot_allowed_signers \
		-m "Allow $(hostname -s) signing key" \
		-m "Auto-generated by run_once_set-up-3-ssh.sh on $(hostname -s) at $(date -Iseconds)."
fi
{{ end -}}
