{{ if .desktop -}}
#!/usr/bin/env bash
# vi: set ft=bash
# This script is interactive: it blocks for the PIV PIN, the YubiKey
# touch (when touch-policy is set), and the `gh auth login --web`
# browser flow. The YubiKey is the only SSH auth identity available
# until the per-machine ed25519 is registered on netcup and GitHub.
# Run from a real terminal with the YubiKey plugged in, not from CI.
set -euo pipefail

LOCAL_KEY="$HOME/.ssh/id_ed25519"
LOCAL_PUB="$LOCAL_KEY.pub"
ALLOWED="$HOME/.allowed_signers"
NETCUP=REDACTED

# --- preflight
for bin in ykman ssh-keygen ssh-copy-id gh git; do
	command -v "$bin" >/dev/null || { echo ">missing $bin" >&2; exit 1; }
done

# --- wait for YubiKey (no exit on absence)
while ! ykman piv info >/dev/null 2>&1; do
	read -rp ">plug in YubiKey and press Enter"
done

# --- 1. local key
if [ ! -f "$LOCAL_KEY" ] || [ ! -f "$LOCAL_PUB" ]; then
	echo '>generating per-machine ed25519 key'
	ssh-keygen -t ed25519 -C "$(hostname -s) $(date +%Y-%m-%d)" -f "$LOCAL_KEY"
fi

# --- 2. REDACTED
# SSH config provides PKCS11Provider for this host, so the PIV cert is
# available as a fallback identity when the per-machine ed25519 is not
# yet registered (the bootstrap case).
# -f skips the macOS launchd-ssh-agent quirk in ssh-copy-id's "is this
# key already installed?" probe (it logs "failed to fetch key" then exits
# 1 even when the key would otherwise authenticate fine).
echo '>authorising local key on REDACTED'
ssh-copy-id -f -i "$LOCAL_PUB" "$NETCUP"

# --- 3. GitHub
echo '>logging in to GitHub'
gh auth login \
	--hostname github.com \
	--git-protocol ssh \
	--web \
	--scopes admin:public_key \
	--skip-ssh-key
echo '>registering local key on GitHub'
gh ssh-key add "$LOCAL_PUB" --title "$(hostname -s) $(date +%Y-%m-%d)"

# --- 4. update allowed signers + commit
# Commits to the chezmoi-configured sourceDir (i.e. the main checkout, not
# any worktree). Run `chezmoi apply` from the main checkout on a real
# machine, not from inside a worktree.
# We use $CHEZMOI_SOURCE_DIR (set by chezmoi when running scripts) rather
# than call `chezmoi source-path`: the parent `chezmoi apply` already
# holds the persistent-state lock, and a nested chezmoi invocation would
# deadlock waiting for it. See run_once_after-set-chezmoi-remote-url.sh
# for the same pattern.
PUB_LINE=$(awk '{print $1, $2}' "$LOCAL_PUB")
HOST_TAG="@$(hostname -s)"
LINE="andre@terroir.systems $PUB_LINE $HOST_TAG"
KEY_FP=$(awk '{print $2}' "$LOCAL_PUB")
mkdir -p "$(dirname "$ALLOWED")"
touch "$ALLOWED"
chmod 644 "$ALLOWED"
if grep -qF "$KEY_FP" "$ALLOWED"; then
	echo '>~/.allowed_signers already has this key'
else
	echo "$LINE" >> "$ALLOWED"
fi
if ! git -C "$CHEZMOI_SOURCE_DIR" diff --quiet -- dot_allowed_signers; then
	git -C "$CHEZMOI_SOURCE_DIR" commit --only dot_allowed_signers \
		-m "Allow $(hostname -s) signing key" \
		-m "Auto-generated by run_once_set-up-3-ssh.sh on $(hostname -s) at $(date -Iseconds)."
fi
{{ end -}}
