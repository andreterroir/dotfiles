#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

echo "> orb setup: checking system packages"
packages=(ca-certificates curl git shellcheck)
missing_packages=()
for package in "${packages[@]}"; do
	if ! dpkg-query --show --showformat='${db:Status-Status}' "$package" 2>/dev/null | grep -qx installed; then
		missing_packages+=("$package")
	fi
done

if ((${#missing_packages[@]})); then
	if ((EUID == 0)); then
		apt=(apt-get)
	else
		apt=(sudo apt-get)
	fi
	"${apt[@]}" update
	"${apt[@]}" install --yes "${missing_packages[@]}"
fi

export PATH="$HOME/.local/bin:$PATH"
if ! command -v chezmoi >/dev/null; then
	echo "> orb setup: installing chezmoi"
	mkdir -p "$HOME/.local/bin"
	curl -fsLS get.chezmoi.io | sh -s -- -b "$HOME/.local/bin"
fi

chezmoi --version
shellcheck --version | sed -n '1p'
git -C "$repo_root" rev-parse --is-inside-work-tree >/dev/null
