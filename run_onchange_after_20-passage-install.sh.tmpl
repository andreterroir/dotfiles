{{ if .passage -}}
#!/usr/bin/env bash
# vi: set ft=bash
# passage has no package on Fedora or macOS, and it is a shell script,
# so it is installed from a pinned tag into ~/.local.
# WITH_BASHCOMP forces the bash completion, which the Makefile would
# otherwise skip when ~/.local/share/bash-completion/completions is absent.
set -euo pipefail

passage_version=1.7.4a2
passage_src="$(mktemp -d)"
git clone -c advice.detachedHead=false --quiet --depth 1 --branch "$passage_version" \
	https://github.com/FiloSottile/passage "$passage_src"
platform="$passage_src/src/platform/darwin.sh"
sed "s#hdid -drivekey system-image=yes -nomount 'ram://32768' | cut -d ' ' -f 1#diskutil image attach --noMount 'ram://32768' | cut -f 1#" \
	"$platform" > "$platform.new"
mv "$platform.new" "$platform"
grep -Fq "diskutil image attach --noMount 'ram://32768' | cut -f 1" "$platform"
make -C "$passage_src" install PREFIX="$HOME/.local" WITH_BASHCOMP=yes
rm -rf "$passage_src"

# passage has no `otp` command; pass-otp provides it as an extension, and
# only develop knows about passage (no release since 1.2.0), so the commit
# is pinned. This is the SYSTEM_EXTENSION_DIR baked in from PREFIX above.
otp_commit=7bb50dbc4b6073f12f40be66a5ee371b9652a646
otp_src="$(mktemp -d)"
git -C "$otp_src" init --quiet
git -C "$otp_src" fetch --quiet --depth 1 \
	https://github.com/pass-extension/pass-otp "$otp_commit"
git -C "$otp_src" checkout --quiet FETCH_HEAD
install -d "$HOME/.local/lib/passage/extensions" \
	"$HOME/.local/share/bash-completion/completions"
install -m 0755 "$otp_src/otp.bash" "$HOME/.local/lib/passage/extensions/otp.bash"
install -m 0644 "$otp_src/pass-otp.bash.completion" \
	"$HOME/.local/share/bash-completion/completions/pass-otp"
rm -rf "$otp_src"
{{ end -}}
