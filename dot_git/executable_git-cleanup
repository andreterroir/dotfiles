#!/usr/bin/env bash
# git-cleanup: remove worktrees with no changes and branches merged into
# the current branch.
#
# Usage: git cleanup [-n|--dry-run] [-h|--help]

set -euo pipefail

usage() {
    cat <<'EOF'
Usage: git cleanup [-n|--dry-run] [-h|--help]

Remove worktrees with a clean working tree and local branches that have
been fully merged into the current branch.

Options:
  -n, --dry-run   print what would be removed; do not modify anything
  -h, --help      show this help and exit

Protected branches (never deleted): main, master, develop
EOF
}

dry_run=0
for arg in "$@"; do
    case "$arg" in
        -n|--dry-run) dry_run=1 ;;
        -h|--help)    usage; exit 0 ;;
        *)            printf 'git-cleanup: unknown argument: %s\n' "$arg" >&2
                      usage >&2
                      exit 2 ;;
    esac
done

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "git-cleanup: not inside a git working tree" >&2
    exit 1
fi

current_branch=$(git symbolic-ref --quiet --short HEAD || true)
if [ -z "$current_branch" ]; then
    echo "git-cleanup: HEAD is detached; refusing to clean up branches" >&2
    exit 1
fi

main_path=$(git worktree list --porcelain | sed -n 's/^worktree //p' | head -1)
cwd_worktree=$(git rev-parse --show-toplevel)

run() {
    if [ "$dry_run" -eq 1 ]; then
        printf 'DRY-RUN: %s\n' "$*"
        return 0
    fi
    "$@"
}

printf '==> Scanning worktrees (main: %s, cwd: %s)\n' "$main_path" "$cwd_worktree"
worktree_removed=0
while IFS=$'\t' read -r path lock_state; do
    [ -n "$path" ] || continue
    # Never remove the main worktree or the one we are running from.
    if [ "$path" = "$main_path" ] || [ "$path" = "$cwd_worktree" ]; then
        continue
    fi
    if [ ! -d "$path" ]; then
        # Stale entry; the end-of-script prune will clean it up.
        continue
    fi
    if [ "$lock_state" = "locked" ]; then
        printf 'skip worktree (locked): %s\n' "$path"
        continue
    fi
    if status_output=$(git -C "$path" status --porcelain 2>/dev/null); then
        if [ -z "$status_output" ]; then
            worktree_removed=$((worktree_removed + 1))
            if ! run git worktree remove "$path"; then
                worktree_removed=$((worktree_removed - 1))
                printf 'failed to remove worktree: %s\n' "$path" >&2
            fi
        else
            printf 'skip worktree (has changes): %s\n' "$path"
        fi
    else
        printf 'skip worktree (status failed): %s\n' "$path" >&2
    fi
done < <(git worktree list --porcelain | awk '
    /^worktree / { path = substr($0, 10); locked = 0; next }
    /^locked/    { locked = 1; next }
    /^$/         { if (path != "") { print path (locked ? "\tlocked" : ""); path = ""; locked = 0 } }
    END          { if (path != "") print path (locked ? "\tlocked" : "") }
')

printf '==> Scanning branches (current: %s)\n' "$current_branch"
branch_removed=0
while IFS= read -r branch; do
    [ -n "$branch" ] || continue
    [ "$branch" = "$current_branch" ] && continue
    case "$branch" in
        main|master|develop) continue ;;
    esac
    if [ -n "$(git branch --list "$branch" --merged "$current_branch" 2>/dev/null)" ]; then
        branch_removed=$((branch_removed + 1))
        if ! run git branch -d "$branch"; then
            branch_removed=$((branch_removed - 1))
            printf 'failed to delete branch: %s\n' "$branch" >&2
        fi
    else
        printf 'skip branch (not merged): %s\n' "$branch"
    fi
done < <(git for-each-ref --format='%(refname:short)' refs/heads/)

run git worktree prune

printf '==> Done. worktrees: %d, branches: %d\n' \
    "$worktree_removed" "$branch_removed"
