# vi: ft=bash
# shellcheck shell=bash

# Skip if not running interactively
[[ "$-" == *i* ]] || return

alias ls='ls --classify --color=auto'
alias cz='chezmoi'
alias g='git'
alias grep='grep --color=auto'
alias python='python3'
alias v='vim'
alias vi='vim'
alias t='tmux attach || tmux new'
if ! command -v fd > /dev/null && command -v fdfind > /dev/null ; then
	alias fd='fdfind'
fi

# ssh passes TERM to the remote, which needs a terminfo entry for it. Send the
# name every host has rather than xterm-ghostty or tmux-256color.
ssh() { TERM=xterm-256color command ssh "$@"; }

# Enable CTRL-S for forward history search
# (overwrites suspension of terminal output)
stty -ixon

export HISTSIZE=100000
export HISTFILESIZE=100000
# Append history file when shell exits
shopt -s histappend

# Blinking block cursor
printf '\e[1 q'

# Customize Git repository prompt. The escapes print literally under
# sh and dash, so gate the prompt on bash.
if [ -n "${BASH_VERSION:-}" ]; then
	# Load Git helper function and customize repository prompt
	if [ -f /usr/lib/git-core/git-sh-prompt ]; then
		# Ubuntu
		source /usr/lib/git-core/git-sh-prompt
	elif [ -f /usr/share/git-core/contrib/completion/git-prompt.sh ]; then
		# Fedora
		source /usr/share/git-core/contrib/completion/git-prompt.sh
	fi
	# Keep the prompt plain rather than erroring when no helper was found
	command -v __git_ps1 > /dev/null || __git_ps1() { :; }
	export GIT_PS1_SHOWDIRTYSTATE=1 # +/*
	export GIT_PS1_SHOWSTASHSTATE=1 # $
	export GIT_PS1_SHOWUNTRACKEDFILES=1 # %
	export GIT_PS1_SHOWUPSTREAM=auto
	# Color the classic (user@host:workdir$) prompt
	# 032   - green
	# 034   - blue
	export PS1='\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]$(__git_ps1 " [%s]") \$ '
	# Set terminal window title to user@host: workdir
	export PS1="\[\e]0;\u@\h: \w\a\]$PS1"
fi

# Enable completion. Amp requires Bash 4+ and bash-completion.
if [ -r /etc/profile.d/bash_completion.sh ]; then
	source /etc/profile.d/bash_completion.sh
elif [ -r /usr/share/bash-completion/bash_completion ]; then
	source /usr/share/bash-completion/bash_completion
fi
command -v chezmoi > /dev/null && source <(chezmoi completion bash)
# Enable Cargo completion
command -v rustup > /dev/null && source <(rustup completions bash cargo)
command -v rustup > /dev/null && source <(rustup completions bash rustup)
# Load Amp completions at runtime (per https://ampcode.com/docs/cli)
command -v amp > /dev/null && source <(amp completions bash)

# fzf key bindings (Ctrl-T, Ctrl-R, Alt-C) and ** completion.
# fzf --bash (0.48+) embeds both. Older Ubuntu packages have no
# --bash; completions/fzf is completion.bash, but bash-completion
# only loads it when completing the fzf command, so source it here.
if command -v fzf > /dev/null; then
	_fzf_bash="$(fzf --bash 2>/dev/null)" || true
	if [ -n "$_fzf_bash" ]; then
		eval "$_fzf_bash"
	else
		for _fzf_bindings in \
			/usr/share/fzf/shell/key-bindings.bash \
			/usr/share/doc/fzf/examples/key-bindings.bash
		do
			if [ -r "$_fzf_bindings" ]; then
				source "$_fzf_bindings"
				break
			fi
		done
		unset _fzf_bindings
		for _fzf_completion in \
			/usr/share/doc/fzf/examples/completion.bash \
			/usr/share/bash-completion/completions/fzf
		do
			if [ -r "$_fzf_completion" ]; then
				source "$_fzf_completion"
				break
			fi
		done
		unset _fzf_completion
	fi
	unset _fzf_bash
fi

# Load machine-specific configuration
[ -f ~/.bashrc.local ] && source ~/.bashrc.local

# mise-managed tools (zig, exercism, rust, topgrade)
if command -v mise > /dev/null; then
	eval "$(mise activate bash)"
fi
