{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "formatter": true,
  "permission": {
    "external_directory": {
      "/tmp/**": "allow",
      "/private/tmp/**": "allow",
      "~/.agents/**": "allow"
    },
    "read": {
      "~/.agents/**": "allow",
      "~/.config/opencode/AGENTS.md": "allow"
    },
    "edit": {
      "~/.agents/**": "deny"
    }
  }
}
