#!/usr/bin/env bash
# The CLI owns this file, so merge the managed keys into its content.
set -euo pipefail
managed='{"$schema":"https://ampcode.com/cli-settings.schema.json","amp.remoteThreadCreation.enabled":true,"amp.runner.env.enabled":true}'
current=$(cat)
if [ -z "$current" ]; then
	printf '%s\n' "$managed"
elif command -v jq >/dev/null 2>&1; then
	printf '%s' "$current" | jq --argjson managed "$managed" '. + $managed'
else
	echo '>amp settings: jq missing; leaving the file unchanged' >&2
	printf '%s\n' "$current"
fi
