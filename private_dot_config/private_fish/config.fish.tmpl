fish_add_path $HOME/bin $HOME/.bin $HOME/.local/bin
{{- if eq .chezmoi.os "darwin" }}
fish_add_path /opt/homebrew/bin
{{- end }}

# Rust
set -gx CARGO_TARGET_DIR "$HOME/.cache/cargo/target"
set -gx RUSTUP_HOME "$HOME/.cache/rustup"
fish_add_path $HOME/.cargo/bin

# Go
set -gx GOPATH "$HOME/.cache/go"
fish_add_path $HOME/.cache/go/bin

{{ if eq .chezmoi.os "darwin" -}}
# Prefer Homebrew coreutils and gnu-sed over macOS defaults
set -gx HOMEBREW_NO_AUTO_UPDATE 1
if command -q brew
    fish_add_path (brew --prefix)/opt/gnu-sed/libexec/gnubin
    fish_add_path (brew --prefix)/opt/coreutils/libexec/gnubin
end
{{ end -}}

set --global --export EDITOR nvim
set -gx LESS '--RAW-CONTROL-CHARS'
set -gx XZ_DEFAULTS '--threads=0'
set -gx ZSTD_COMPRESS '--threads=0'
set -gx MAKEFLAGS "-j"(nproc)

# Use blinking block cursor for prompt
function on_fish_prompt --on-event fish_prompt
  echo -ne '\e[1 q'
end

# Load local opencode config override if present
set -l _oc_local ~/.config/opencode/opencode.local.json
if test -f $_oc_local
    set --global --export OPENCODE_CONFIG $_oc_local
end

# Load Amp completions at runtime (per https://ampcode.com/docs/cli)
if status is-interactive; and command -q amp
    amp completions fish | source
end

# mise-managed tools (zig, exercism, rust, topgrade)
if status is-interactive; and command -q mise
    mise activate fish | source
end

source $__fish_config_dir/config.local.fish 2>/dev/null
