[Unit]
Description=Amp runner serving ~/code

[Service]
Type=simple
WorkingDirectory=%h/code
# Threads inherit this service's environment, so mirror ~/.bash_profile's PATH.
Environment=PATH=%h/.local/share/mise/shims:%h/.cargo/bin:%h/.cache/go/bin:%h/.bin:%h/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/amp --no-tui --runner-id %H --dir %h/code/dotfiles --discover-dirs --remote-control-portals
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
