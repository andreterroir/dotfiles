theme = light:GitHub Light Default,dark:GitHub Dark
font-family = JetBrains Mono
font-feature = -calt, -liga, -dlig
font-size = 16
{{ with lookPath "tmux" -}}
# direct: so Ghostty execs tmux instead of wrapping it in bash --posix
initial-command = direct:{{ . }} new -A
{{- end }}
confirm-close-surface = false
shell-integration = detect
cursor-style = block
cursor-style-blink = true
# keep shell integration from overriding the block cursor with a bar
shell-integration-features = no-cursor
keybind = f11=toggle_fullscreen
