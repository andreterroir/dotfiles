{{ if .desktop -}}
#!/usr/bin/env bash
# vi: set ft=bash
set -euo pipefail

passage_dir="$HOME/.passage"
plugins="$passage_dir/plugin-identities"
{{ if eq .chezmoi.hostname "slate" -}}
local_identities="$passage_dir/local-identities"
{{ end -}}
identities="$passage_dir/identities"

umask 077
tmp="$(mktemp "$passage_dir/.identities.XXXXXX")"
trap 'rm -f "$tmp"' EXIT
cat "$plugins" > "$tmp"
{{ if eq .chezmoi.hostname "slate" -}}
if [ -f "$local_identities" ]; then
	chmod 600 "$local_identities"
	cat "$local_identities" >> "$tmp"
fi
{{ end -}}

if [ -f "$identities" ] && cmp -s "$tmp" "$identities"; then
	chmod 600 "$identities"
	exit 0
fi
mv "$tmp" "$identities"
trap - EXIT
{{ end -}}
