#!/usr/bin/env bash
# vi: set ft=bash
# passage is a desktop tool, and servers have neither it nor a store, so
# the chezmoi update hook has to be a no-op there.
set -euo pipefail

command -v passage > /dev/null || exit 0
git -C "$HOME/.passage/store" rev-parse --is-inside-work-tree > /dev/null 2>&1 || exit 0

{{ include ".chezmoitemplates/approved-yubikeys.bash" }}
if [ "$(hostname -s)" = x1 ] && [ -f "$HOME/.ssh/id_ed25519" ] &&
	[ -f "$HOME/.ssh/id_ed25519.pub" ]; then
	passage git pull --rebase --quiet && passage git push --quiet
	exit 0
fi

agent_keys="$(ssh-add -L 2>/dev/null || true)"
authorized=false
for allowed_key in "${approved_yubikeys[@]}"; do
	if awk -v key="$allowed_key" '$1 " " $2 == key { found = 1 } END { exit !found }' <<<"$agent_keys"; then
		authorized=true
		break
	fi
done
[ "$authorized" = true ] || exit 0

passage git pull --rebase --quiet && passage git push --quiet
