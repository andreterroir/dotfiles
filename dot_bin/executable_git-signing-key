#!/usr/bin/env bash
# vi: set ft=bash
# Print the public key Git signs with. Interactive commits require a
# FIDO2 resident key; automated commits use this machine's ed25519 key.
set -euo pipefail

machine_key="$HOME/.ssh/id_ed25519.pub"
yubikey_keys=(
	'sk-ssh-ed25519@openssh.com AAAAGnNrLXNzaC1lZDI1NTE5QG9wZW5zc2guY29tAAAAIBvW6Zw+GAYm4zXEt6Cumdv82ORF0Jhw2Qh9Nq48pdJpAAAACHNzaDo1bmZj'
	'sk-ssh-ed25519@openssh.com AAAAGnNrLXNzaC1lZDI1NTE5QG9wZW5zc2guY29tAAAAIHeTStXm0VUd8cz/M2HJWf1WVb7oa+OyWtFnOyqIlLViAAAAC3NzaDo1Yy1uYW5v'
)

if [ "${GIT_SIGNING_KEY:-}" = "machine" ]; then
	if [ -f "$machine_key" ]; then
		printf 'key::%s\n' "$(cat "$machine_key")"
		exit 0
	fi
	echo 'git-signing-key: no machine SSH signing key available' >&2
	exit 1
fi

agent_keys="$(ssh-add -L 2>/dev/null || true)"
sk_key=""
for yubikey_key in "${yubikey_keys[@]}"; do
	candidate="$(awk -v key="$yubikey_key" '$1 " " $2 == key { print; exit }' <<<"$agent_keys")"
	if [ -n "$candidate" ]; then
		sk_key="$candidate"
		break
	fi
done

if tty -s; then
	if [ -z "$sk_key" ]; then
		echo 'git-signing-key: no authorized resident YubiKey key in the agent' >&2
		exit 1
	fi
	# git only accepts a bare key when the type starts with ssh-; a FIDO2
	# key is sk-ssh-…, so it needs the key:: prefix.
	printf 'key::%s\n' "$sk_key"
elif [ -f "$machine_key" ]; then
	printf 'key::%s\n' "$(cat "$machine_key")"
else
	echo 'git-signing-key: no SSH signing key available' >&2
	exit 1
fi
