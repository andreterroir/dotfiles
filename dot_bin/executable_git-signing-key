#!/usr/bin/env bash
# vi: set ft=bash
# Print the public key git signs with: the first FIDO2 resident key in
# the agent, else this machine's own ed25519 key. A server with no
# forwarded agent falls back to its machine key, which is what
# unattended runs need.
set -euo pipefail

agent_keys="$(ssh-add -L 2>/dev/null || true)"
sk_key="$(printf '%s\n' "$agent_keys" | sed -n '/^sk-ssh-ed25519/{p;q;}')"

if [ -n "$sk_key" ]; then
	printf '%s\n' "$sk_key"
elif [ -f "$HOME/.ssh/id_ed25519.pub" ]; then
	cat "$HOME/.ssh/id_ed25519.pub"
else
	echo 'git-signing-key: no SSH signing key available' >&2
	exit 1
fi
