#!/usr/bin/env bash
# git-cleanup: remove worktrees with no changes and branches merged into
# the current branch.
#
# Usage: git cleanup [-n|--dry-run] [-h|--help]

set -euo pipefail

usage() {
    cat <<'EOF'
Usage: git cleanup [-n|--dry-run] [-h|--help]

Remove worktrees with a clean working tree and local branches that have
been fully merged into the current branch.

Options:
  -n, --dry-run   print what would be removed; do not modify anything
  -h, --help      show this help and exit

Protected branches (never deleted): main, master, develop

Branches currently checked out in another worktree are skipped.
EOF
}

dry_run=0
for arg in "$@"; do
    case "$arg" in
        -n|--dry-run) dry_run=1 ;;
        -h|--help)    usage; exit 0 ;;
        *)            printf 'git-cleanup: unknown argument: %s\n' "$arg" >&2
                      usage >&2
                      exit 2 ;;
    esac
done

# Fails outside any git repo; exits 0 (printing true/false) inside one.
if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "git-cleanup: not inside a git working tree" >&2
    exit 1
fi

current_branch=$(git symbolic-ref --quiet --short HEAD || true)
if [ -z "$current_branch" ]; then
    echo "git-cleanup: HEAD is detached; refusing to clean up branches" >&2
    exit 1
fi

main_path=$(git worktree list --porcelain | sed -n 's/^worktree //p' | head -1)
cwd_worktree=$(git rev-parse --show-toplevel)

relpath_from_main() {
    python3 -c 'import os,sys; sys.stdout.write(os.path.relpath(sys.argv[1], sys.argv[2]))' "$1" "$main_path"
}

run() {
    if [ "$dry_run" -eq 1 ]; then
        return 0
    fi
    "$@"
}

prefix=""
if [ "$dry_run" -eq 1 ]; then
    prefix="[dry-run] "
fi

printf '%sWorktree cleanup:\n' "$prefix"
worktree_removed=0
while IFS=$'\t' read -r path lock_state; do
    [ -n "$path" ] || continue
    # Never remove the main worktree or the one we are running from.
    if [ "$path" = "$main_path" ] || [ "$path" = "$cwd_worktree" ]; then
        continue
    fi
    display=$(relpath_from_main "$path")
    if [ ! -d "$path" ]; then
        # Stale entry; the prune below will clean it up.
        continue
    fi
    if [ "$lock_state" = "locked" ]; then
        printf '  %s skipped (locked)\n' "$display"
        continue
    fi
    if status_output=$(git -C "$path" status --porcelain 2>/dev/null); then
        if [ -z "$status_output" ]; then
            if run git worktree remove "$path"; then
                printf '  %s\n' "$display"
                worktree_removed=$((worktree_removed + 1))
            else
                printf 'failed to remove worktree: %s\n' "$display" >&2
            fi
        else
            printf '  %s skipped (has changes)\n' "$display"
        fi
    else
        printf 'failed to check worktree status: %s\n' "$display" >&2
    fi
done < <(git worktree list --porcelain | awk '
    /^worktree / { path = substr($0, 10); locked = 0; next }
    /^locked/    { locked = 1; next }
    /^$/         { if (path != "") { print path (locked ? "\tlocked" : ""); path = ""; locked = 0 } }
    END          { if (path != "") print path (locked ? "\tlocked" : "") }
')
printf '  %d removed\n' "$worktree_removed"
run git worktree prune

# Branches currently checked out in a worktree cannot be deleted with
# `git branch -d`; collect them up front so the branch loop can skip them.
declare -A worktree_branch_paths=()
while IFS=$'\t' read -r wt_path wt_branch; do
    [ -n "$wt_path" ] && [ -n "$wt_branch" ] && worktree_branch_paths["$wt_branch"]="$wt_path"
done < <(git worktree list --porcelain | awk '
    /^worktree /   { path = substr($0, 10); branch = ""; next }
    /^branch refs\/heads\// { branch = substr($0, 19); next }
    /^$/           { if (path != "" && branch != "") { print path "\t" branch; path = ""; branch = "" } }
    END            { if (path != "" && branch != "") print path "\t" branch }
')

printf '\n'

printf '%sBranch cleanup:\n' "$prefix"
branch_removed=0
while IFS= read -r branch; do
    [ -n "$branch" ] || continue
    [ "$branch" = "$current_branch" ] && continue
    case "$branch" in
        main|master|develop) continue ;;
    esac
    if [ -n "${worktree_branch_paths[$branch]+set}" ]; then
        printf '  %s skipped (checked out in worktree %s)\n' \
            "$branch" "$(relpath_from_main "${worktree_branch_paths[$branch]}")"
        continue
    fi
    if [ -n "$(git branch --list "$branch" --merged "$current_branch" 2>/dev/null)" ]; then
        if [ "$dry_run" -eq 1 ] || err=$(git branch -d "$branch" 2>&1); then
            printf '  %s\n' "$branch"
            branch_removed=$((branch_removed + 1))
        else
            err=${err#error: }
            printf 'failed to delete branch %s: %s\n' "$branch" "$err" >&2
        fi
    else
        printf '  %s skipped (not merged)\n' "$branch"
    fi
done < <(git for-each-ref --format='%(refname:short)' refs/heads/)
printf '  %d removed\n' "$branch_removed"
