" ----------------
" journal
" ----------------
function! s:journal_date(offset) abort
  return strftime('%Y-%m-%d', localtime() + a:offset * 86400)
endfunction

" date(1) parses an existing journal name. GNU and BSD flag sets differ.
" system() is given a string: classic Vim rejects a List here.
function! s:journal_shift(ymd, step) abort
  if a:ymd !~# '\v^\d{4}-\d{2}-\d{2}$'
    echomsg 'unexpected journal date: ' . a:ymd
    return ''
  endif
  let n = a:step < 0 ? -a:step : a:step
  let sign = a:step < 0 ? '-' : '+'
  let spec = a:ymd . ' ' . sign . n . ' days'
  let gnu = system('date -d ' . shellescape(spec) . ' +%F')
  if v:shell_error == 0
    return substitute(gnu, '\n$', '', '')
  endif
  let bsd = system('date -j -f %Y-%m-%d ' . shellescape(a:ymd) . ' -v' . a:step . 'd +%F')
  if v:shell_error == 0
    return substitute(bsd, '\n$', '', '')
  endif
  echomsg 'cannot shift journal date'
  return ''
endfunction

function! s:journal_for_offset(offset) abort
  let notes = expand('~/notes')
  let day = s:journal_date(a:offset)
  if day ==# ''
    return
  endif
  execute 'cd' fnameescape(notes)
  execute 'edit' fnameescape(notes . '/journal/' . day . '.md')
endfunction

command! JournalToday call s:journal_for_offset(0)
command! JournalTomorrow call s:journal_for_offset(1)
command! JournalYesterday call s:journal_for_offset(-1)

function! s:journal_next(step) abort
  let path = expand('%:p')
  if path ==# ''
    echomsg 'buffer has no path'
    return
  endif
  if path !~# 'journal'
    echomsg 'not a journal buffer'
    return
  endif
  let stem = fnamemodify(path, ':t:r')
  let matched = matchlist(stem, '\v(\d{4})-(\d{2})-(\d{2})')
  if empty(matched)
    echomsg 'unexpected journal file format: ' . path
    return
  endif
  let i = 1
  while i <= 30
    let next = s:journal_shift(matched[1] . '-' . matched[2] . '-' . matched[3], i * a:step)
    if next ==# ''
      return
    endif
    let next_file = substitute(path, '\v\d{4}-\d{2}-\d{2}', next, '')
    if filereadable(next_file)
      execute 'edit' fnameescape(next_file)
      return
    endif
    let i += 1
  endwhile
  echomsg 'no more close journal files'
endfunction

nnoremap <leader>j; :call <SID>journal_next(1)<CR>
nnoremap <leader>j, :call <SID>journal_next(-1)<CR>

