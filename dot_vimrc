" an empty mode maps like :map: normal, visual, select, operator-pending
function! s:Map(mode, lhs, rhs) abort
  execute a:mode . 'noremap ' . a:lhs . ' ' . a:rhs
endfunction

let g:goyo_width = 80
let g:floaterm_keymap_toggle = '<A-;>'
" gitgutter maps are global; dot_vimrc defines the ones it wants
let g:gitgutter_map_keys = 0

" vim-plug hides uninstalled plugins, so configure them only once installed
let s:missing = filter(copy(g:plugs), '!isdirectory(v:val.dir)')

if empty(s:missing)
  try
    let g:startify_custom_header = []
    let g:startify_lists = [
          \ {'type': 'commands', 'header': ['   Commands']},
          \ {'type': 'files', 'header': ['   Recent']},
          \ ]
    let g:startify_commands = [
          \ {'f': ['Find file', 'Files']},
          \ {'r': ['Recent files', 'History']},
          \ {'g': ['Find text', 'Rg']},
          \ {'c': ['Config', 'edit ~/.vimrc']},
          \ {'o': ['Load session', 'Load']},
          \ {'l': ['Last session', 'Last']},
          \ ]
    let g:startify_custom_footer = ['', 'vim loaded ' . len(g:plugs) . ' plugins']
  catch
    echohl ErrorMsg
    echomsg 'vim: plugin setup failed: ' . v:exception
    echohl None
  endtry
else
  echohl WarningMsg
  echomsg printf('vim-plug: %d plugin(s) missing, run :PlugInstall and restart', len(s:missing))
  echohl None
endif

" -------------
" -- options --
" -------------

" a block cursor in every mode, blinking in those that take typed text
let &t_ti ..= "\e[2 q"
" and a blinking one back at the prompt on exit
let &t_te ..= "\e[1 q"

function! s:Cursor(seq) abort
  if empty(a:seq)
    return
  endif
  try
    call writefile([a:seq], '/dev/tty', 'b')
  catch
  endtry
endfunction

" a terminal job passes on the shape of the program inside it
function! s:Shape(mode) abort
  if a:mode ==# 't'
    return ''
  elseif a:mode =~# "^[iRscS\x13]"
    return "\e[1 q"
  endif
  return "\e[2 q"
endfunction

augroup cursor_blink
  autocmd!
  autocmd ModeChanged * call s:Cursor(s:Shape(v:event.new_mode))
augroup END

" render in the terminal theme's own colours: no colorscheme, no true colour
syntax off
filetype on
filetype plugin off
filetype indent on

" defaults Neovim provided and Vim does not
set backspace=indent,eol,start
set hidden
set autoindent
set mouse=nvi
set whichwrap=b,s
set nrformats=bin,hex
set formatoptions=tcqj
set nostartofline
set shortmess=ltToOCF
set wildoptions=pum,tagfile
" always show the status line, so a single window still names its file
set laststatus=2

" tabs are 4 spaces, except where a file type says otherwise
set tabstop=4
set softtabstop=4
set shiftwidth=4
set noexpandtab

" use a space as the vertical split character
let &fillchars = 'vert: '
" show trailing characters, tabs and non-breakable spaces
set list
let &listchars = 'tab:  ,trail:·,nbsp:⍽,extends:»,precedes:«'
" indent wrapped lines, with a marker
set breakindent
let &showbreak = '↳ '
" recognize bullets as well as numbered lists
let &formatlistpat = '^\s*\(\d\+[\]:.)}]*\|[-\*+]\)\s\+'
" shift list items by their prefix, past the breakindent
set breakindentopt=sbr,list:-1
" wrap into the number column
set cpoptions+=n
" conceal syntax, keeping code block marks highlighted
set conceallevel=1
set number
" highlight the line number for the current line
set cursorline
set cursorlineopt=number
" show signs in the number column, with no separate gutter
set signcolumn=number
" open folds by default
set foldlevelstart=99

" check for hunks often enough for gitgutter signs
set updatetime=100

set nohlsearch
set wildmode=longest:full,full
" how long a prefix waits before which-key opens
set timeoutlen=500

set backup
" write in place, so a backup keeps the file's birthtime
set backupcopy=yes
" keep backups, swap files, undo history and sessions out of the working tree
let s:cache_dir = expand('~/.cache/vim')
let s:state_dir = expand('~/.local/state/vim')
for s:dir in [s:cache_dir . '/backup', s:state_dir . '/swap', s:state_dir . '/undo']
  if !isdirectory(s:dir)
    call mkdir(s:dir, 'p')
  endif
endfor
let &backupdir = s:cache_dir . '/backup//'
let &directory = s:state_dir . '/swap//'
let &undodir = s:state_dir . '/undo//'
set undofile
" no plaintext copy of a secret in the state directories
augroup secrets
  autocmd!
  autocmd BufRead,BufNewFile /tmp/*,$HOME/.ssh/* setlocal noundofile noswapfile
augroup END
let &backupskip = &backupskip . ',' . expand('~/.ssh') . '/*,/tmp/*'

