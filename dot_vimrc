" ----------------
" sessions
" ----------------
" One session per directory. Not persistence.nvim: nothing restores on startup,
" and :Last is the previous directory recorded by this vimrc.
let s:session_dir = expand('~/.cache/vim/sessions')
if !isdirectory(s:session_dir)
  call mkdir(s:session_dir, 'p')
endif
let s:last_session = s:session_dir . '/last'

function! s:session_path(dir) abort
  return s:session_dir . '/' . substitute(fnamemodify(a:dir, ':p'), '[^A-Za-z0-9]', '_', 'g') . '.vim'
endfunction

function! s:session_save() abort
  if argc() == 0 && expand('%') ==# '' && winnr('$') == 1
    return
  endif
  let path = s:session_path(getcwd())
  execute 'mksession!' fnameescape(path)
  call writefile([path], s:last_session)
endfunction

function! s:session_load(last) abort
  if a:last
    if !filereadable(s:last_session)
      echomsg 'no last session'
      return
    endif
    let path = readfile(s:last_session)[0]
  else
    let path = s:session_path(getcwd())
  endif
  if !filereadable(path)
    echomsg 'no session: ' . path
    return
  endif
  execute 'source' fnameescape(path)
endfunction

command! Load call s:session_load(0)
command! Last call s:session_load(1)
augroup session
  autocmd!
  autocmd VimLeavePre * call s:session_save()
augroup END

