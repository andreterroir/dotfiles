{{ if eq .chezmoi.os "linux" -}}
{{   if and (eq .distro "fedora") .desktop -}}
#!/usr/bin/env bash
# vi: set ft=bash
set -euo pipefail

# The release is part of the script, so an upgrade re-fetches the extension.
# Fedora {{ .chezmoi.osRelease.versionID }}
ego_uuid=nightthemeswitcher@romainvigier.fr
fedora_extensions=(
	ddterm@amezin.github.com
	windowsNavigator@gnome-shell-extensions.gcampax.github.com
	launch-new-instance@gnome-shell-extensions.gcampax.github.com
	appindicatorsupport@rgcjonas.gmail.com
)

shell_version="$(gnome-shell --version | awk '{print $3}')"
download_dir="$(mktemp -d)"
trap 'rm -rf "$download_dir"' EXIT

# Reinstall on every change, so no build for an older shell survives.
if ! info="$(curl -fsSL \
	"https://extensions.gnome.org/extension-info/?uuid=$ego_uuid&shell_version=$shell_version")"; then
	echo ">cannot query extensions.gnome.org for $ego_uuid; skipping" >&2
	exit 0
fi
url="$(printf '%s' "$info" | jq -r '.download_url // empty')"
if [ -z "$url" ]; then
	echo ">no $ego_uuid build for GNOME Shell $shell_version; skipping" >&2
	exit 0
fi
echo ">installing $ego_uuid"
if ! curl -fsSL -o "$download_dir/extension.zip" "https://extensions.gnome.org$url" ||
	! gnome-extensions install --force "$download_dir/extension.zip"; then
	echo ">cannot install $ego_uuid; skipping" >&2
	exit 0
fi

# The Shell watches both keys, so this takes effect now or at the next login.
# A uuid must also leave disabled-extensions, which wins over enabled-extensions.
python3 - "$ego_uuid" "${fedora_extensions[@]}" <<'PY'
import ast
import subprocess
import sys

schema = "org.gnome.shell"
wanted = sys.argv[1:]


def read(key):
    value = subprocess.run(
        ["gsettings", "get", schema, key],
        check=True,
        capture_output=True,
        text=True,
    ).stdout.strip()
    return ast.literal_eval(value.removeprefix("@as "))


def write(key, values):
    value = "[" + ", ".join(f"'{uuid}'" for uuid in values) + "]"
    subprocess.run(["gsettings", "set", schema, key, value], check=True)


enabled = read("enabled-extensions")
write("enabled-extensions", enabled + [uuid for uuid in wanted if uuid not in enabled])
disabled = read("disabled-extensions")
write("disabled-extensions", [uuid for uuid in disabled if uuid not in wanted])
PY
{{   end -}}
{{ end -}}
