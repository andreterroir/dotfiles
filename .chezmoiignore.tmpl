{{- if ne (env "AMP_ORB") "" -}}
{{- fail "Amp orbs are not a supported target; this set-up does not run inside one" -}}
{{- end -}}
{{- if not (hasKey . "keepass") -}}
{{- fail "KeePass provisioning policy is missing; run chezmoi init before apply or update" -}}
{{- end -}}
{{- if ne .keepass (and .desktop (not .vm)) -}}
{{- fail "KeePass provisioning policy is stale; run chezmoi init before apply or update" -}}
{{- end -}}
{{- if not (hasKey . "transient") -}}
{{- fail "Transient provisioning policy is missing; run chezmoi init before apply or update" -}}
{{- end -}}
AGENTS.md
assets
license
readme.md
plug-snapshot.vim
install.sh
{{ if eq .chezmoi.os "linux" -}}
icloud
{{ end -}}
{{ if eq .chezmoi.os "darwin" -}}
# the target path, not the dot_bin/ source name
.bin/swap_ctrl_caps
{{ end -}}
{{ if ne .chezmoi.os "darwin" -}}
Library
{{ else if not .keepass -}}
Library/Application Support/KeePassXC
{{ end -}}
{{ if or (ne .chezmoi.os "linux") (not .keepass) -}}
.config/keepassxc
{{ end -}}
{{ if .transient -}}
# identity agents stay out of transient environments
.config/systemd/user/ssh-agent.service
.config/systemd/user/gcr-ssh-agent.service.d
{{ end -}}
{{ if eq .chezmoi.os "linux" -}}
{{   if not .server -}}
.config/systemd/user/ssh-agent.service
{{   end -}}
{{   if not .linux.desktop -}}
.config/systemd/user/gcr-ssh-agent.service.d
{{   end -}}
{{   if not (and (eq .chezmoi.osRelease.id "fedora") .linux.desktop) -}}
.config/autostart/syncthing-start.desktop
{{   end -}}
{{   if not (and (eq .chezmoi.osRelease.id "fedora") .linux.desktop) -}}
.config/ghostty
{{   end -}}
{{ else -}}
.config/systemd
.config/autostart/syncthing-start.desktop
# developer tools only the Linux package scripts install
.config/mise
.config/opencode
.config/topgrade.toml
{{ end -}}
.config/opencode/opencode.local.json
