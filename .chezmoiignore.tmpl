{{- if not (and (hasKey . "desktop") (hasKey . "devserver") (hasKey . "transient") (hasKey . "work")) -}}
{{- fail "Profile data is missing; run chezmoi init before apply or update" -}}
{{- end -}}
{{- $desktop := .desktop -}}
{{- $transient := .transient -}}
AGENTS.md
assets
license
readme.md
plug-snapshot.vim
install.sh
{{ if not (and (eq .distro "fedora") $desktop .vm) -}}
# Ghostty's software-GL shims are for Fedora desktop VMs
.config/systemd/user/app-com.mitchellh.ghostty.service.d
.bin/ghostty
{{ end -}}
{{ if $transient -}}
# portable files only
10-ssh-identity.sh
amp-runner.sh
allowed-signers.sh
.bash_profile
.bashrc
.claude
.codex
.copilot
.config/amp
.config/autostart
.config/mise
.config/opencode
.config/systemd
.config/topgrade.toml
.bin/git-editor
.gitconfig
.gitignore
.ssh
.tmux.conf
tmux-plugins.sh
{{ end -}}
{{ if .work -}}
# a work machine runs no Amp runner
amp-runner.sh
.config/systemd/user/amp-runner.service
{{ end -}}
{{ if not $desktop -}}
# the swap script needs GNOME
.bin/swap_ctrl_caps
{{ end -}}
{{ if not (and (eq .distro "fedora") $desktop (not .vm)) -}}
.config/autostart/syncthing-start.desktop
{{ end -}}
{{ if not (and (eq .distro "fedora") $desktop) -}}
.config/ghostty
{{ end -}}
.config/opencode/opencode.local.json
