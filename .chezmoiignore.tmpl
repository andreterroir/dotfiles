{{- if not (and (hasKey . "desktop") (hasKey . "devserver") (hasKey . "transient") (hasKey . "work")) -}}
{{- fail "Profile data is missing; run chezmoi init before apply or update" -}}
{{- end -}}
{{- $desktop := .desktop -}}
{{- $transient := .transient -}}
AGENTS.md
assets
license
readme.md
plug-snapshot.vim
install.sh
{{ if not (and $desktop .vm) -}}
# Ghostty's software-GL shims and Virtual-1 scale watcher are for desktop VMs
.config/systemd/user/app-com.mitchellh.ghostty.service.d
.bin/ghostty
.bin/vm-display-scale
.config/systemd/user/vm-display-scale.service
{{ end -}}
{{ if not .vm -}}
# the SPICE guest session agent only exists in VMs
.config/systemd/user/spice-vdagent.service.d
{{ end -}}
{{ if $transient -}}
# portable files only
10-ssh-identity.sh
amp-runner.sh
allowed-signers.sh
.bash_profile
.bashrc
.claude
.codex
.copilot
.config/amp
.config/autostart
.config/mise
.config/opencode
.config/systemd
.config/topgrade.toml
.bin/git-editor
.gitconfig
.gitignore
.ssh
.tmux.conf
tmux-plugins.sh
{{ end -}}
{{ if .work -}}
# a work machine installs no Amp and runs no Amp runner
amp-runner.sh
.config/amp
.config/systemd/user/amp-runner.service
{{ end -}}
{{ if not $desktop -}}
# desktop-only configuration
.bin/swap_ctrl_caps
.config/ghostty
{{ end -}}
{{ if not (and $desktop (not .vm)) -}}
.config/autostart/syncthing-start.desktop
{{ end -}}
