{{ if and (eq .chezmoi.os "linux") (not .transient) -}}
{{   if eq .distro "fedora" -}}
#!/usr/bin/env bash
# vi: set ft=bash
set -euo pipefail

# Terra's main repo, the documented Ghostty install path; it also carries
# mise and topgrade. Do not enable terra-release-extras, -mesa or -multimedia.
if ! rpm -q terra-release >/dev/null; then
	sudo dnf install -y --nogpgcheck \
		--repofrompath "terra,https://repos.fyralabs.com/terra\$releasever" \
		terra-release terra-gpg-keys
fi

sudo dnf install -y \
	ShellCheck \
	bash-completion \
	chezmoi \
	fd-find \
	fzf \
	gh \
	git-lfs \
	gnupg2 \
	golang \
	jq \
	mise \
	opencode-cli \
	remove-retired-packages \
	ripgrep \
	tree \
	tmux \
	topgrade \
	vim-enhanced \
	wget2-wget

{{ if .desktop -}}
sudo dnf install -y \
	ImageMagick \
	ghostty \
	gnome-extensions-app \
	gnome-shell-extension-appindicator \
	gnome-shell-extension-ddterm \
	gnome-shell-extension-launch-new-instance \
	gnome-shell-extension-windowsNavigator \
	gnome-tweaks \
{{ if and .desktop (not .vm) }}	keepassxc \
{{ end }}	make \
	meld \
	powertop \
	syncthing \
	wl-clipboard \
	yt-dlp \
	hugo \
	jetbrains-mono-fonts \
	yubikey-manager \
	pcsc-tools

# Enabled, not started: pcscd comes up at the next boot, then on demand.
sudo systemctl enable pcscd

# Spotify's Flathub package is x86_64-only. Name the remote, and add
# Flathub when it is not configured yet, instead of relying on a
# previous setup.
sudo flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
flatpak install --system --assumeyes flathub \
{{ if eq .chezmoi.arch "amd64" }}	com.spotify.Client \
{{ end }}	org.signal.Signal \
	org.telegram.desktop \
	org.zotero.Zotero

{{   end -}}
{{   else if and (eq .distro "ubuntu") .devserver -}}
#!/usr/bin/env bash
# vi: set ft=bash
# Headless Ubuntu only. hugo is intentionally omitted.
set -euo pipefail

# mise's own apt repo, which installs zig, exercism and topgrade.
# Ubuntu has no mise package. apt accepts an ASCII-armored keyring when
# it is named .asc, which avoids a gpg --dearmor step (and its gnupg
# dependency) on a fresh server.
# https://mise.jdx.dev/installing-mise.html
if ! command -v mise > /dev/null; then
	sudo mkdir -p -m 755 /etc/apt/keyrings
	curl -fsSL https://mise.jdx.dev/gpg-key.pub \
		| sudo tee /etc/apt/keyrings/mise-archive-keyring.asc > /dev/null
	sudo chmod go+r /etc/apt/keyrings/mise-archive-keyring.asc
	echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/mise-archive-keyring.asc] https://mise.jdx.dev/deb stable main" \
		| sudo tee /etc/apt/sources.list.d/mise.list > /dev/null
fi

sudo apt-get update
sudo apt-get install -y \
	bash-completion \
	ca-certificates \
	curl \
	fd-find \
	fzf \
	git \
	git-lfs \
	golang-go \
	jq \
	mise \
	ncurses-term \
	ripgrep \
	shellcheck \
	tmux \
	tree \
	vim \
	wget \
	xz-utils

# Fedora's fd-find package provides `fd`; Ubuntu's provides `fdfind`.
if [ ! -e "$HOME/.local/bin/fd" ]; then
	mkdir -p "$HOME/.local/bin"
	ln -s "$(command -v fdfind)" "$HOME/.local/bin/fd"
fi

# Official GitHub CLI apt repo. Ubuntu's own gh package is absent or
# stale; a third-party package (snap, pacstall) must not satisfy this.
if ! dpkg-query -W -f '${Maintainer}' gh 2>/dev/null | grep -qx 'GitHub'; then
	sudo mkdir -p -m 755 /etc/apt/keyrings
	keyring="$(mktemp)"
	wget -qO "$keyring" https://cli.github.com/packages/githubcli-archive-keyring.gpg
	sudo tee /etc/apt/keyrings/githubcli-archive-keyring.gpg < "$keyring" > /dev/null
	rm -f "$keyring"
	sudo chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg
	if [ ! -f /etc/apt/sources.list.d/github-cli.list ]; then
		echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
			| sudo tee /etc/apt/sources.list.d/github-cli.list > /dev/null
	fi
	sudo apt-get update
	sudo apt-get install -y gh
fi

# chezmoi's documented binary install. Apt has no chezmoi package.
if ! command -v chezmoi > /dev/null; then
	sh -c "$(curl -fsLS get.chezmoi.io)" -- -b "$HOME/.local/bin"
fi

{{   end -}}
{{   if and (eq .distro "ubuntu") .devserver -}}
# --no-modify-path skips the installer's shell PATH edit. Link the
# binary into ~/.local/bin, which is already on PATH.
if [ ! -x "$HOME/.opencode/bin/opencode" ]; then
	echo '>installing opencode'
	curl -fsSL https://opencode.ai/install | bash -s -- --no-modify-path
fi
mkdir -p "$HOME/.local/bin"
ln -sfn "$HOME/.opencode/bin/opencode" "$HOME/.local/bin/opencode"

{{   end -}}
{{   if or (eq .distro "fedora") (and (eq .distro "ubuntu") .devserver) -}}
if [ ! -x "$HOME/.local/bin/amp" ]; then
	echo '>installing amp'
	curl -fsSL https://ampcode.com/install.sh | bash
fi
{{   end -}}
{{ end -}}
