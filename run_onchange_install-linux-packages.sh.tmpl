{{ if eq .chezmoi.osRelease.id "fedora" -}}
#!/usr/bin/env bash
# vi: set ft=bash
set -e

sudo dnf install -y \
	ShellCheck \
	chezmoi \
	exercism \
	fd-find \
	fish \
	fzf \
	gh \
	git-lfs \
	gnupg2 \
	golang \
	hugo \
	jetbrains-mono-fonts \
	jq \
	neovim \
	nodejs \
	npm \
	pass \
	pass-otp \
	pcsc-tools \
	ripgrep \
	tree \
	tree-sitter-cli \
	tmux \
	wget2-wget \
	yubico-piv-tool \
	yubikey-manager \
	zig

sudo systemctl enable --now pcscd

{{ if .linux.desktop -}}
sudo dnf install -y \
	ImageMagick \
	gnome-extensions-app \
	gnome-tweaks \
	meld \
	powertop \
	syncthing \
	wl-clipboard \
	yt-dlp

flatpak install --assumeyes \
	com.spotify.Client \
	md.obsidian.Obsidian \
	org.signal.Signal \
	org.telegram.desktop \
	org.zotero.Zotero

{{ end -}}
# Fish already adds ~/.opencode/bin. --no-modify-path skips the
# installer's ~/.bashrc PATH edit.
if [ ! -x "$HOME/.opencode/bin/opencode" ]; then
	echo '>installing opencode'
	curl -fsSL https://opencode.ai/install | bash -s -- --no-modify-path
fi

if [ ! -d "$HOME/.tmux/plugins/tpm" ]; then
	echo '>installing TPM'
	git clone https://github.com/tmux-plugins/tpm "$HOME/.tmux/plugins/tpm"
fi
{{ else if and (eq .chezmoi.osRelease.id "ubuntu") .server -}}
#!/usr/bin/env bash
# vi: set ft=bash
# Headless Ubuntu only. fish and hugo are intentionally omitted.
# nodejs is not installed: nothing in this repo requires it.
set -euo pipefail

sudo apt-get update
sudo apt-get install -y \
	ca-certificates \
	curl \
	fd-find \
	fzf \
	git \
	git-lfs \
	golang-go \
	jq \
	ncurses-term \
	neovim \
	ripgrep \
	shellcheck \
	tmux \
	tree \
	tree-sitter-cli \
	wget \
	xz-utils

# Fedora's fd-find package provides `fd`; Ubuntu's provides `fdfind`.
if [ ! -e "$HOME/.local/bin/fd" ]; then
	mkdir -p "$HOME/.local/bin"
	ln -s "$(command -v fdfind)" "$HOME/.local/bin/fd"
fi

# Official GitHub CLI apt repo. Ubuntu's own gh package is absent or
# stale; a third-party package (snap, pacstall) must not satisfy this.
if ! dpkg-query -W -f '${Maintainer}' gh 2>/dev/null | grep -qx 'GitHub'; then
	sudo mkdir -p -m 755 /etc/apt/keyrings
	keyring="$(mktemp)"
	wget -qO "$keyring" https://cli.github.com/packages/githubcli-archive-keyring.gpg
	sudo tee /etc/apt/keyrings/githubcli-archive-keyring.gpg < "$keyring" > /dev/null
	rm -f "$keyring"
	sudo chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg
	if [ ! -f /etc/apt/sources.list.d/github-cli.list ]; then
		echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
			| sudo tee /etc/apt/sources.list.d/github-cli.list > /dev/null
	fi
	sudo apt-get update
	sudo apt-get install -y gh
fi

# chezmoi's documented binary install. Apt has no chezmoi package.
if ! command -v chezmoi > /dev/null; then
	sh -c "$(curl -fsLS get.chezmoi.io)" -- -b "$HOME/.local/bin"
fi

# Exercism publishes release tarballs only; there is no apt package.
# https://exercism.org/cli-walkthrough
# Pinned: bump the version and checksums together.
exercism_version=3.5.8
if ! command -v exercism > /dev/null; then
	case "$(uname -m)" in
		x86_64)
			exercism_arch=x86_64
			exercism_sha=4ce6a3e5e41e4c51606f8cb94ef6b46e8f45144ef8c613c1ea4b8b69209e02ad
			;;
		aarch64)
			exercism_arch=arm64
			exercism_sha=0d2474eba53b14a8e4965c0d3c77b74d037058d2d76c55496deda63c7044d281
			;;
		*) echo "unsupported architecture for exercism: $(uname -m)" >&2; exit 1 ;;
	esac
	exercism_tmp="$(mktemp -d)"
	curl -fsSL -o "$exercism_tmp/exercism.tar.gz" \
		"https://github.com/exercism/cli/releases/download/v${exercism_version}/exercism-${exercism_version}-linux-${exercism_arch}.tar.gz"
	echo "$exercism_sha  $exercism_tmp/exercism.tar.gz" | sha256sum --check
	tar -xzf "$exercism_tmp/exercism.tar.gz" -C "$exercism_tmp" exercism
	install -D -m 755 "$exercism_tmp/exercism" "$HOME/.local/bin/exercism"
	rm -rf "$exercism_tmp"
fi

# Pinned tagged release, not Ubuntu's zig metapackage (0.14).
# https://ziglang.org/download/
# Compare the copy this script owns. An older zig earlier in PATH,
# such as ~/bin/zig, must not hide it or force a reinstall.
zig_version=0.16.0
if [ ! -x "$HOME/.local/bin/zig" ] || [ "$("$HOME/.local/bin/zig" version)" != "$zig_version" ]; then
	case "$(uname -m)" in
		x86_64)
			zig_arch=x86_64
			zig_sha=70e49664a74374b48b51e6f3fdfbf437f6395d42509050588bd49abe52ba3d00
			;;
		aarch64)
			zig_arch=aarch64
			zig_sha=ea4b09bfb22ec6f6c6ceac57ab63efb6b46e17ab08d21f69f3a48b38e1534f17
			;;
		*) echo "unsupported architecture for zig: $(uname -m)" >&2; exit 1 ;;
	esac
	zig_tarball="zig-${zig_arch}-linux-${zig_version}.tar.xz"
	zig_tmp="$(mktemp -d)"
	curl -fsSL -o "$zig_tmp/$zig_tarball" \
		"https://ziglang.org/download/${zig_version}/${zig_tarball}"
	echo "$zig_sha  $zig_tmp/$zig_tarball" | sha256sum --check
	rm -rf "$HOME/.local/zig"
	tar -xJf "$zig_tmp/$zig_tarball" -C "$HOME/.local"
	mv "$HOME/.local/zig-${zig_arch}-linux-${zig_version}" "$HOME/.local/zig"
	mkdir -p "$HOME/.local/bin"
	ln -sfn "$HOME/.local/zig/zig" "$HOME/.local/bin/zig"
	rm -rf "$zig_tmp"
fi

# Official release binary in ~/.local/bin, ahead of any distro package.
# Apt has no topgrade; the release .deb is a one-off, not a repo.
# Pinned: bump the version and checksums together.
topgrade_version=17.12.2
if [ ! -x "$HOME/.local/bin/topgrade" ]; then
	case "$(uname -m)" in
		x86_64)
			topgrade_arch=x86_64
			topgrade_sha=4d6660a2f021cf34c823c1baf4499a7cace581b5415935f6c5fc5484858faf8e
			;;
		aarch64)
			topgrade_arch=aarch64
			topgrade_sha=ebe0750313da6ae5cca7888f0ca4652272b29b8711b1e8c2ded35b8ce29a57d4
			;;
		*) echo "unsupported architecture for topgrade: $(uname -m)" >&2; exit 1 ;;
	esac
	topgrade_tmp="$(mktemp -d)"
	curl -fsSL -o "$topgrade_tmp/topgrade.tar.gz" \
		"https://github.com/topgrade-rs/topgrade/releases/download/v${topgrade_version}/topgrade-v${topgrade_version}-${topgrade_arch}-unknown-linux-gnu.tar.gz"
	echo "$topgrade_sha  $topgrade_tmp/topgrade.tar.gz" | sha256sum --check
	tar -xzf "$topgrade_tmp/topgrade.tar.gz" -C "$topgrade_tmp"
	install -D -m 755 "$topgrade_tmp/topgrade" "$HOME/.local/bin/topgrade"
	rm -rf "$topgrade_tmp"
fi

# Fish already adds ~/.opencode/bin. --no-modify-path skips the
# installer's ~/.bashrc PATH edit.
if [ ! -x "$HOME/.opencode/bin/opencode" ]; then
	echo '>installing opencode'
	curl -fsSL https://opencode.ai/install | bash -s -- --no-modify-path
fi

if [ ! -d "$HOME/.tmux/plugins/tpm" ]; then
	echo '>installing TPM'
	git clone https://github.com/tmux-plugins/tpm "$HOME/.tmux/plugins/tpm"
fi
{{ end }}
