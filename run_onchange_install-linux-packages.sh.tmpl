{{ if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
# vi: set ft=bash
set -e

sudo dnf install -y \
	ShellCheck \
	bash-completion \
	chezmoi \
	fd-find \
	fish \
	fzf \
	gh \
	git-lfs \
	gnupg2 \
	golang \
	hugo \
	jetbrains-mono-fonts \
	jq \
	neovim \
	nodejs \
	npm \
	pass \
	pass-otp \
	ripgrep \
	tree \
	tree-sitter-cli \
	tmux \
	wget2-wget \
	wl-clipboard \
	zig

{{ if or (eq .chezmoi.hostname "black") (eq .chezmoi.hostname "xps13") -}}
sudo dnf install -y \
	ImageMagick \
	gnome-extensions-app \
	gnome-tweaks \
	meld \
	powertop \
	syncthing \
	yt-dlp

flatpak install --assumeyes \
	com.spotify.Client \
	md.obsidian.Obsidian \
	org.signal.Signal \
	org.telegram.desktop \
	org.zotero.Zotero

{{ end -}}
if [ ! -d "$HOME/.tmux/plugins/tpm" ]; then
	echo '>installing TPM'
	git clone https://github.com/tmux-plugins/tpm "$HOME/.tmux/plugins/tpm"
fi

{{ end }}
