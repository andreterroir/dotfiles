#!/usr/bin/env bash
# vi: set ft=bash
set -e

# Terra's main repo, the documented Ghostty install path. Do not enable
# terra-release-extras, -mesa or -multimedia.
if ! rpm -q terra-release >/dev/null; then
	sudo dnf install -y --nogpgcheck \
		--repofrompath "terra,https://repos.fyralabs.com/terra\$releasever" \
		terra-release terra-gpg-keys
fi

# mise's own RPM repo, which installs zig and exercism. Not Terra.
# https://mise.jdx.dev/installing-mise.html
if [ ! -f /etc/yum.repos.d/mise.repo ]; then
	curl -fsSL https://mise.jdx.dev/rpm/mise.repo | sudo tee /etc/yum.repos.d/mise.repo > /dev/null
fi

sudo dnf install -y \
	ShellCheck \
	age \
	bash-completion \
	chezmoi \
	fd-find \
	fish \
	fzf \
	gh \
	ghostty \
	git-lfs \
	gnupg2 \
	gnupg2-scdaemon \
	golang \
	hugo \
	jetbrains-mono-fonts \
	jq \
	mise \
	neovim \
	nodejs \
	npm \
	opencode-cli \
	pass \
	pass-otp \
	pcsc-tools \
	ripgrep \
	tree \
	tree-sitter-cli \
	tmux \
	topgrade \
	wget2-wget \
	yubico-piv-tool \
	yubikey-manager

sudo systemctl enable --now pcscd

{{ if .linux.desktop -}}
sudo dnf install -y \
	ImageMagick \
	gnome-extensions-app \
	gnome-tweaks \
	make \
	meld \
	pcsc-lite-devel \
	powertop \
	syncthing \
	wl-clipboard \
	yt-dlp

flatpak install --assumeyes \
	com.spotify.Client \
	md.obsidian.Obsidian \
	org.signal.Signal \
	org.telegram.desktop \
	org.zotero.Zotero

