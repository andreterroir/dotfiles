{{ if and (eq .chezmoi.os "linux") (not .transient) -}}
{{   if eq .distro "fedora" -}}
#!/usr/bin/env bash
# vi: set ft=bash
set -euo pipefail

# Terra: Ghostty's documented install path, which also carries mise and topgrade
if ! rpm -q terra-release >/dev/null; then
	sudo dnf install -y --nogpgcheck \
		--repofrompath "terra,https://repos.fyralabs.com/terra\$releasever" \
		terra-release terra-gpg-keys
fi

sudo dnf install -y \
	ShellCheck \
	bash-completion \
	chezmoi \
	dnf5-plugin-automatic \
	fd-find \
	fzf \
	gh \
	git-lfs \
	gnupg2 \
	golang \
	jq \
	mise \
	opencode-cli \
	remove-retired-packages \
	ripgrep \
	tree \
	tmux \
	topgrade \
	vim-enhanced \
	wget2-wget

{{ if .desktop -}}
{{ if not .work -}}
# Amp's own dnf repository; amp-desktop updates with the rest of the system.
sudo curl --fail --location --show-error \
	--output /etc/yum.repos.d/amp.repo \
	https://static.ampcode.com/linux/amp.repo

{{ end -}}
sudo dnf install -y \
	ImageMagick \
{{ if not .work }}	amp-desktop \
{{ end }}	ghostty \
	gnome-extensions-app \
	gnome-shell-extension-appindicator \
	gnome-shell-extension-ddterm \
	gnome-shell-extension-launch-new-instance \
	gnome-shell-extension-windowsNavigator \
	gnome-tweaks \
{{ if and .desktop (not .vm) }}	keepassxc \
{{ end }}	make \
	meld \
	powertop \
{{ if not .vm }}	syncthing \
{{ end }}	wl-clipboard \
	yt-dlp \
	hugo \
	jetbrains-mono-fonts

# shellcheck disable=SC2194 # chezmoi renders .chezmoi.arch before linting
case "{{ .chezmoi.arch }}" in
	amd64)
		rpm_arch=x86_64
		opencode_sha256=ae7a3122d7f3a430f1cdb0d7f26b6b8fafb9cf260e2fdbb5c80303d3b4d0d3ba
		;;
	arm64)
		rpm_arch=aarch64
		opencode_sha256=8ecffaaaa963ffa530442a3c1ffc24aa86fccfcd33aa028afd3c8a06cce08b3b
		;;
	*) echo "unsupported desktop RPM architecture: {{ .chezmoi.arch }}" >&2; exit 1 ;;
esac
opencode_rpm="$(mktemp --suffix=.rpm)"
chatgpt_rpm=""
trap 'rm -f "$opencode_rpm" "$chatgpt_rpm"' EXIT
curl --fail --location --show-error \
	--output "$opencode_rpm" \
	"https://opencode.ai/files/bin/2.3.2/opencode-desktop-linux-${rpm_arch}.rpm"
echo "${opencode_sha256}  ${opencode_rpm}" | sha256sum --check --status
sudo dnf install -y "$opencode_rpm"

# ChatGPT Desktop (includes Codex); the RPM adds OpenAI's signed dnf repo.
if ! rpm -q chatgpt >/dev/null; then
	chatgpt_rpm="$(mktemp --suffix=.rpm)"
	curl --fail --location --show-error \
		--output "$chatgpt_rpm" \
		"https://persistent.oaistatic.com/codex-app-prod/linux/rpm/latest/chatgpt.${rpm_arch}.rpm"
	sudo dnf install -y "$chatgpt_rpm"
fi

{{ if not .vm -}}
# Personal apps stay off a VM; Spotify's Flathub build is x86_64-only
sudo flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
flatpak install --system --assumeyes flathub \
{{ if eq .chezmoi.arch "amd64" }}	com.spotify.Client \
{{ end }}	io.github.friesi23.mhabit \
	org.signal.Signal \
	org.telegram.desktop \
	org.zotero.Zotero
{{ end -}}

{{   end -}}
{{   else if and (eq .distro "ubuntu") .devserver -}}
#!/usr/bin/env bash
# vi: set ft=bash
# Headless Ubuntu only.
set -euo pipefail

# mise's own apt repo; an ASCII-armored .asc keyring needs no gpg --dearmor.
if ! command -v mise > /dev/null; then
	sudo mkdir -p -m 755 /etc/apt/keyrings
	curl -fsSL https://mise.jdx.dev/gpg-key.pub \
		| sudo tee /etc/apt/keyrings/mise-archive-keyring.asc > /dev/null
	sudo chmod go+r /etc/apt/keyrings/mise-archive-keyring.asc
	echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/mise-archive-keyring.asc] https://mise.jdx.dev/deb stable main" \
		| sudo tee /etc/apt/sources.list.d/mise.list > /dev/null
fi

sudo apt-get update
sudo apt-get install -y \
	bash-completion \
	ca-certificates \
	curl \
	fd-find \
	fzf \
	git \
	git-lfs \
	golang-go \
	jq \
	mise \
	ncurses-term \
	ripgrep \
	shellcheck \
	tmux \
	tree \
	vim \
	wget \
	xz-utils

# Fedora's fd-find package provides `fd`; Ubuntu's provides `fdfind`.
if [ ! -e "$HOME/.local/bin/fd" ]; then
	mkdir -p "$HOME/.local/bin"
	ln -s "$(command -v fdfind)" "$HOME/.local/bin/fd"
fi

# GitHub's own CLI repo; a snap or a stale Ubuntu package must not satisfy this.
if ! dpkg-query -W -f '${Maintainer}' gh 2>/dev/null | grep -qx 'GitHub'; then
	sudo mkdir -p -m 755 /etc/apt/keyrings
	keyring="$(mktemp)"
	wget -qO "$keyring" https://cli.github.com/packages/githubcli-archive-keyring.gpg
	sudo tee /etc/apt/keyrings/githubcli-archive-keyring.gpg < "$keyring" > /dev/null
	rm -f "$keyring"
	sudo chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg
	if [ ! -f /etc/apt/sources.list.d/github-cli.list ]; then
		echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
			| sudo tee /etc/apt/sources.list.d/github-cli.list > /dev/null
	fi
	sudo apt-get update
	sudo apt-get install -y gh
fi

# chezmoi's documented binary install; apt has no package for it.
if ! command -v chezmoi > /dev/null; then
	sh -c "$(curl -fsLS get.chezmoi.io)" -- -b "$HOME/.local/bin"
fi

{{   end -}}
{{   if and (eq .distro "ubuntu") .devserver -}}
# --no-modify-path skips the installer's PATH edit; link into ~/.local/bin.
if [ ! -x "$HOME/.opencode/bin/opencode" ]; then
	echo '>installing opencode'
	curl -fsSL https://opencode.ai/install | bash -s -- --no-modify-path
fi
mkdir -p "$HOME/.local/bin"
ln -sfn "$HOME/.opencode/bin/opencode" "$HOME/.local/bin/opencode"

{{   end -}}
{{   if and (not .work) (or (eq .distro "fedora") (and (eq .distro "ubuntu") .devserver)) -}}
if [ ! -x "$HOME/.local/bin/amp" ]; then
	echo '>installing amp'
	curl -fsSL https://ampcode.com/install.sh | bash
fi
{{   end -}}
{{ end -}}
