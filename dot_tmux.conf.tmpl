# vi: ft=tmux

set-option -g escape-time 0
# Distinguish Shift+Enter from Enter in the Amp CLI (docs: ampcode.com/docs/cli/keybindings)
set-option -s extended-keys on
set-option -g prefix C-Space
bind-key -T prefix \; command-prompt
set-option -g history-limit 100000
# Number windows and panes starting from 1
set-option -g base-index 1
set-window-option -g pane-base-index 1

# Open splits in the same directory
bind - split-window -v -c '#{pane_current_path}'
bind \\ split-window -h -c '#{pane_current_path}'
# Ctrl-L/Ctrl-\ (SIGQUIT) is overwritten by vim-tmux-navigator
bind C-l send-keys 'C-l'
bind C-\\ send-keys 'C-\'
# Enable Vim focus events
set-option -g focus-events on
set-option -g mouse on
# Enable true color support
set-option -sa terminal-overrides ',xterm-256color:RGB'
set-option -g default-terminal 'tmux-256color'

set-window-option -g mode-keys vi
bind-key -T copy-mode-vi v send-keys -X begin-selection
bind-key -T copy-mode-vi C-v send-keys -X rectangle-toggle
bind-key -T copy-mode-vi y send-keys -X copy-selection-and-cancel
bind-key -T copy-mode-vi Y send-keys -X copy-end-of-line-and-cancel
bind-key -T copy-mode-vi C-y send-keys -X copy-line-and-cancel
set-option -g set-clipboard on
{{- if .linux.desktop }}
bind -T copy-mode-vi Enter send-keys -X copy-pipe-and-cancel wl-copy
bind-key -T prefix * run "wl-paste --primary | tmux load-buffer - ; tmux paste-buffer"
bind-key -T prefix + run "wl-paste | tmux load-buffer - ; tmux paste-buffer"
{{- else if eq .chezmoi.os "darwin" }}
bind-key -T prefix * run 'pbpaste | tmux load-buffer - ; tmux paste-buffer'
bind-key -T prefix + run 'pbpaste | tmux load-buffer - ; tmux paste-buffer'
{{- end }}

# Restore layout, visible pane text and a few cheap programs after a reboot.
# Pane snapshots hold screen text; keep them out of other users' reach, and
# pin the location resurrect picks (it falls back to XDG when this is absent).
run-shell 'install -d -m 700 ~/.tmux/resurrect'
set -g @resurrect-capture-pane-contents 'on'
set -g @resurrect-pane-contents-area 'visible'
set -g @resurrect-default-processes 'vi vim view nvim emacs man less more'
set -g @continuum-restore 'on'

set-option -g @plugin 'tmux-plugins/tpm'
set-option -g @plugin 'christoomey/vim-tmux-navigator'
set -g @plugin 'tmux-plugins/tmux-open'
set -g @plugin 'ctrlmachine/tmux-amp-theme'
# Keep these after amp-theme: continuum prepends its autosave hook to status-right.
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'
{{- if eq .chezmoi.os "darwin" }}
set -g @plugin 'erikw/tmux-dark-notify'
set -g @dark-notify-theme-path-light '$HOME/.config/tmux/amp-light.conf'
set -g @dark-notify-theme-path-dark '$HOME/.config/tmux/amp-dark.conf'
# Homebrew is only added to PATH in .bash_profile which is loaded by shell later
set-environment -g PATH "/opt/homebrew/bin:$PATH"
run '/opt/homebrew/opt/tpm/share/tpm/tpm'
{{- else }}
set -g @amp-theme-appearance 'auto'
run '~/.tmux/plugins/tpm/tpm'
{{- end }}
# Override after plugins load — amp-theme overwrites these if set earlier.
# amp-{dark,light}.conf repeat status-right; dark-notify re-runs the theme.
# Continuum's autosave runs from a status-right hook it prepends at load, which
# these overrides replace, so the hook is repeated here and in the theme files.
set -g window-status-current-style 'fg=blue,bold'
set -g status-right-length 60
set -g status-right "#(~/.tmux/plugins/tmux-continuum/scripts/continuum_save.sh)#[bg=#161616,fg=#B8AFA0] #{b:pane_current_path} #[bg=#E7894C,fg=#0F0F0F,bold] %H:%M %a %d %b "
