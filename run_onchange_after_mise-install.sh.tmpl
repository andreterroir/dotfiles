{{ if and (eq .chezmoi.os "linux") (not .transient) -}}
#!/usr/bin/env bash
# vi: set ft=bash
{{ if lookPath "mise" -}}
set -euo pipefail

# {{ include "private_dot_config/mise/config.toml.tmpl" | sha256sum }}
mise install --yes
{{ else -}}
# Renders a no-op without mise; once mise exists the changed script re-runs.
echo '>mise: not installed; skipping tool installation' >&2
{{ end -}}
{{ end -}}
