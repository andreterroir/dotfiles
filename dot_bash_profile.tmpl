#!/bin/false
# shellcheck shell=bash
# vi: ft=bash

# Shared environment
export RUSTUP_HOME="$HOME/.cache/rustup"
export GOPATH="$HOME/.cache/go"
export EDITOR=vim
export XZ_DEFAULTS=--threads=0
export ZSTD_COMPRESS=--threads=0
export LESS=--RAW-CONTROL-CHARS

# Prepend user directories; the last prepended is searched first:
# mise, cargo, go, ~/.bin, ~/bin, ~/.local/bin. Managed binaries live in
# ~/.bin, so they win over hand-installed ones in ~/bin.
[ -d "$HOME/.local/bin" ] && PATH="$HOME/.local/bin:$PATH"
[ -e "$HOME/bin" ] && PATH="$HOME/bin:$PATH"
[ -e "$HOME/.bin" ] && PATH="$HOME/.bin:$PATH"
[ -d "$HOME/.cache/go/bin" ] && PATH="$HOME/.cache/go/bin:$PATH"
[ -d "$HOME/.cargo/bin" ] && PATH="$HOME/.cargo/bin:$PATH"
# mise's shims, so shells that never run the interactive activate in
# ~/.bashrc still find the tools mise installs
[ -d "$HOME/.local/share/mise/shims" ] && PATH="$HOME/.local/share/mise/shims:$PATH"
export PATH

# Use all available cores when possible
if command -v nproc > /dev/null; then
	cores=$(nproc)
else
	cores=$(getconf _NPROCESSORS_ONLN)
fi
export MAKEFLAGS="-j$cores"

# Load local opencode config override if present
if [ -f "$HOME/.config/opencode/opencode.local.json" ]; then
	export OPENCODE_CONFIG="$HOME/.config/opencode/opencode.local.json"
fi

# Agents support SSH authentication, encrypted keys, and opt-in YubiKey signing.
{{ if .linux.desktop -}}
# GNOME 46+ runs gcr-ssh-agent. Export its socket if the session has not.
# gcr advertises every ~/.ssh public key and loads it on demand, so
# preloading here would only make ssh-add prompt for the machine key's
# passphrase in every login shell.
if [ -z "${SSH_AUTH_SOCK:-}" ] && [ -S "${XDG_RUNTIME_DIR:-}/gcr/ssh" ]; then
	export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/gcr/ssh"
fi
{{ end -}}

# Source machine-local login override
[ -f "$HOME/.bash_profile.local" ] && source "$HOME/.bash_profile.local"

# Source the interactive config
[ -f "$HOME/.bashrc" ] && source "$HOME/.bashrc"
