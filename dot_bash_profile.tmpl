#!/bin/false
# shellcheck shell=bash
# vi: ft=bash

# Shared environment
# age-plugin-yubikey 0.5.1 panics at startup when LANG is unset
# (locale_config fails to parse Apple's AppleLocale region suffix).
export LANG=en_US.UTF-8
export CARGO_TARGET_DIR="$HOME/.cache/cargo/target"
export RUSTUP_HOME="$HOME/.cache/rustup"
export GOPATH="$HOME/.cache/go"
export EDITOR=nvim
export XZ_DEFAULTS=--threads=0
export ZSTD_COMPRESS=--threads=0
export LESS=--RAW-CONTROL-CHARS

{{ if eq .chezmoi.os "darwin" -}}
# Homebrew binaries. User directories are prepended after this so they
# win.
if [ -d "/opt/homebrew/" ]; then
	export HOMEBREW_NO_AUTO_UPDATE
	eval "$(/opt/homebrew/bin/brew shellenv)"
	export SSH_AUTH_SOCK="$HOME/.ssh/homebrew-agent.sock"
	# Use homebrew utilities instead of macOS provided commands
	PATH="$(brew --prefix)/opt/gnu-sed/libexec/gnubin:$PATH"
	PATH="$(brew --prefix)/opt/coreutils/libexec/gnubin:$PATH"
fi
{{ end -}}
# Prepend user directories; the last prepended is searched first:
# mise, cargo, go, ~/bin, ~/.bin, ~/.local/bin.
[ -d "$HOME/.local/bin" ] && PATH="$HOME/.local/bin:$PATH"
[ -e "$HOME/.bin" ] && PATH="$HOME/.bin:$PATH"
[ -e "$HOME/bin" ] && PATH="$HOME/bin:$PATH"
[ -d "$HOME/.cache/go/bin" ] && PATH="$HOME/.cache/go/bin:$PATH"
[ -d "$HOME/.cargo/bin" ] && PATH="$HOME/.cargo/bin:$PATH"
# mise's shims, so shells that never run the interactive activate in
# ~/.bashrc still find the tools mise installs
[ -d "$HOME/.local/share/mise/shims" ] && PATH="$HOME/.local/share/mise/shims:$PATH"
export PATH

# Use all available cores when possible
if command -v nproc > /dev/null; then
	cores=$(nproc)
else
	cores=$(getconf _NPROCESSORS_ONLN)
fi
export MAKEFLAGS="-j$cores"

# Load local opencode config override if present
if [ -f "$HOME/.config/opencode/opencode.local.json" ]; then
	export OPENCODE_CONFIG="$HOME/.config/opencode/opencode.local.json"
fi

# Commit-signing agent, so unattended commits find a key through the
# agent. Interactive commits still sign with the YubiKey resident key.
{{ if .linux.desktop -}}
# GNOME 46+ runs gcr-ssh-agent. Export its socket if the session has not,
# then preload the signing keys so an unattended commit finds the machine
# key in the agent; loading a key needs no touch, signing with the
# resident key does.
if [ -z "${SSH_AUTH_SOCK:-}" ] && [ -S "${XDG_RUNTIME_DIR:-}/gcr/ssh" ]; then
	export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/gcr/ssh"
fi
if [ -S "${SSH_AUTH_SOCK:-}" ]; then
	for _signing_key in "$HOME/.ssh/id_ed25519" "$HOME/.ssh/id_ed25519_sk"; do
		if [ -f "$_signing_key" ]; then
			ssh-add "$_signing_key" >/dev/null 2>&1 || true
		fi
	done
	unset _signing_key
fi
{{ end -}}
{{ if and .server (eq .chezmoi.os "linux") -}}
# The ssh-agent user service owns this socket and loads the machine key
# at boot; a forwarded agent, when present, takes precedence.
if [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -S "$XDG_RUNTIME_DIR/ssh-agent.sock" ]; then
	export SSH_AUTH_SOCK="${SSH_AUTH_SOCK:-$XDG_RUNTIME_DIR/ssh-agent.sock}"
fi
{{ end -}}

# Source machine-local login override
[ -f "$HOME/.bash_profile.local" ] && source "$HOME/.bash_profile.local"

# Source the interactive config
[ -f "$HOME/.bashrc" ] && source "$HOME/.bashrc"
