#!/usr/bin/env bash
# vi: set ft=bash
# Finish this machine's SSH identity: put its key on disk and make sure
# GitHub holds it for signing, except on a work machine, which creates only
# its machine key and registers nothing. Every machine reaches GitHub through
# gh over HTTPS; x1's machine key is the only one that also authenticates
# there, and machine keys are the identity remote servers authorize.
# Registration may need a browser login. The identity of a machine does not
# change, so chezmoi runs this once for each version of its rendered content,
# and a provisioned machine passes without touching anything. A step with work
# to do fails without a terminal, so the next apply retries it.
set -euo pipefail

GH_ACCOUNT={{ .githubAccount }}
require_terminal() {
	if [ ! -t 0 ]; then
		echo "error: $1 needs a terminal; run chezmoi apply from one" >&2
		exit 1
	fi
}

# Every machine signs commits with its own ed25519 key by default.
MACHINE_KEY="$HOME/.ssh/id_ed25519"
if { [ -f "$MACHINE_KEY" ] && [ ! -f "$MACHINE_KEY.pub" ]; } ||
	{ [ ! -f "$MACHINE_KEY" ] && [ -f "$MACHINE_KEY.pub" ]; }; then
	echo "error: incomplete machine key pair at $MACHINE_KEY" >&2
	exit 1
fi
if [ ! -f "$MACHINE_KEY" ]; then
{{ if not (or .vm .devserver) -}}
	require_terminal 'generating the machine key'
{{ end -}}
	echo '>generating per-machine ed25519 key'
	ssh-keygen -t ed25519 -C "$(hostname -s) $(date +%F)" -f "$MACHINE_KEY"{{ if or .vm .devserver }} -N ''{{ end }}
fi
{{ if or .vm .devserver -}}
if ! ssh-keygen -y -P '' -f "$MACHINE_KEY" > /dev/null 2>&1; then
	echo "error: machine key must have no passphrase for unattended signing; run ssh-keygen -p -f $MACHINE_KEY from a terminal and leave the new passphrase empty" >&2
	exit 1
fi
{{ end -}}

{{ if .work -}}
# Everything below serves registration with the personal GitHub account, which
# a work machine leaves alone.
echo '>work machine: no keys registered with the personal GitHub account'
exit 0
{{ end -}}
signing_keys_to_add=("$MACHINE_KEY.pub")
auth_keys_to_add=()
{{ if and .desktop (eq .chezmoi.hostname "x1") -}}
auth_keys_to_add+=("$MACHINE_KEY.pub")
{{ end -}}

# Key registrations are public, so check them before touching gh auth:
# a run with nothing to upload skips the browser flow. Buffering the JSON
# avoids curl|grep SIGPIPE false negatives under pipefail. An unreachable
# API leaves the registration unverified, so the run fails and is retried.
# Only x1 registers an authentication key, so no other machine asks for
# the authentication-key endpoint.
registered_auth_keys=''
fetched=true
if [ "${#auth_keys_to_add[@]}" -gt 0 ]; then
	registered_auth_keys="$(curl -fsS "https://api.github.com/users/${GH_ACCOUNT}/keys")" || fetched=false
fi
registered_signing_keys="$(curl -fsS "https://api.github.com/users/${GH_ACCOUNT}/ssh_signing_keys")" || fetched=false
if [ "$fetched" = false ]; then
	echo 'error: GitHub API unavailable; cannot verify key registration; run chezmoi apply when online' >&2
	exit 1
fi

needs_registration=false
for public_key in "${auth_keys_to_add[@]}"; do
	key_material="$(awk '{print $1, $2}' "$public_key")"
	grep -qF "$key_material" <<<"$registered_auth_keys" || needs_registration=true
done
for public_key in "${signing_keys_to_add[@]}"; do
	key_material="$(awk '{print $1, $2}' "$public_key")"
	grep -qF "$key_material" <<<"$registered_signing_keys" || needs_registration=true
done
if [ "$needs_registration" = false ]; then
	echo '>public keys already on GitHub'
	exit 0
fi

# Registration is the only step that needs gh, so an installed key pair
# with nothing to upload still succeeds without it.
if ! command -v gh >/dev/null 2>&1; then
	echo 'error: gh is not installed; cannot register public keys with GitHub; install the GitHub CLI and run chezmoi apply' >&2
	exit 1
fi
require_terminal 'registering public keys with GitHub'

# gh puts the browser flow's one-time code on the clipboard (--clipboard,
# gh 2.79+), so the step is a paste rather than a retype. Offer it only
# when this session has a clipboard gh can use; a headless or remote
# session keeps printing the code.
gh_clipboard=()
if { [ -n "${WAYLAND_DISPLAY:-}" ] && command -v wl-copy >/dev/null &&
	command -v wl-paste >/dev/null; } ||
	command -v xclip >/dev/null || command -v xsel >/dev/null; then
	gh_clipboard=(--clipboard)
fi

# gh may hold several accounts (work + personal): make $GH_ACCOUNT
# active so refresh and add never hit another login.
if gh auth switch --hostname github.com --user "$GH_ACCOUNT" 2>/dev/null; then
	echo ">using GitHub account ${GH_ACCOUNT}"
else
	echo ">logging in to GitHub as ${GH_ACCOUNT} (select this account in the browser)"
	gh auth login --hostname github.com --git-protocol https --web \
		--scopes admin:public_key --scopes admin:ssh_signing_key \
		--skip-ssh-key "${gh_clipboard[@]}"
fi
active="$(gh api user -q .login)"
if [ "$active" != "$GH_ACCOUNT" ]; then
	echo "error: active GitHub account is not ${GH_ACCOUNT}" >&2
	exit 1
fi

# Login requests both scopes, so a token this script created has
# public_key iff it has the signing scope; tokens whose scopes this
# script dropped after a past registration, and only those, need
# topping up again.
if ! grep -qF admin:ssh_signing_key \
	<<<"$(gh auth status --hostname github.com --active 2>&1)"; then
	echo '>extending GitHub token scopes'
	gh auth refresh --hostname github.com \
		--scopes admin:public_key --scopes admin:ssh_signing_key "${gh_clipboard[@]}"
fi

for public_key in "${auth_keys_to_add[@]}"; do
	key_material="$(awk '{print $1, $2}' "$public_key")"
	if ! grep -qF "$key_material" <<<"$registered_auth_keys"; then
		echo '>registering key on GitHub as an authentication key'
		gh ssh-key add "$public_key" --title "$(whoami)@$(hostname -s)-$(basename "$public_key" .pub)"
	fi
done
for public_key in "${signing_keys_to_add[@]}"; do
	key_material="$(awk '{print $1, $2}' "$public_key")"
	if ! grep -qF "$key_material" <<<"$registered_signing_keys"; then
		echo '>registering key on GitHub as a signing key'
		gh ssh-key add "$public_key" --title "$(whoami)@$(hostname -s)-$(basename "$public_key" .pub)" --type signing
	fi
done

# The admin scopes exist to register the keys; a token that keeps them
# lets any process running as this user add SSH keys to the account.
# Dropping scopes needs a browser confirmation, like login does. Not
# fatal: the keys are already on GitHub, and the top-up check above
# re-extends the scopes on a run that needs registration again.
if ! gh auth refresh --hostname github.com \
		--remove-scopes admin:public_key --remove-scopes admin:ssh_signing_key "${gh_clipboard[@]}"; then
	echo 'warning: could not drop the GitHub admin scopes; run gh auth refresh --hostname github.com --remove-scopes admin:public_key,admin:ssh_signing_key by hand' >&2
fi
