#!/usr/bin/env bash
# vi: set ft=bash
# Finish this machine's SSH identity: put its key on disk and make sure
# GitHub holds its machine key for signing and its YubiKey for signing and
# authentication. x1's machine key is also an authentication fallback.
# The sk key download needs a YubiKey touch and registration may need a
# browser login, so a non-tty apply only says how to finish. Re-runs are
# idempotent: a machine whose keys are already on GitHub does nothing.
set -euo pipefail

if [ ! -t 0 ]; then
	echo '>ssh identity: run chezmoi apply from a terminal to finish' >&2
	exit 0
fi

GH_ACCOUNT=andreterroir
{{ include ".chezmoitemplates/approved-yubikeys.bash" }}
is_approved_yubikey() {
	local key="$1" approved_yubikey
	for approved_yubikey in "${approved_yubikeys[@]}"; do
		[ "$key" != "$approved_yubikey" ] || return 0
	done
	return 1
}

{{ if eq .chezmoi.os "darwin" -}}
PATH="/opt/homebrew/opt/openssh/bin:$PATH"
export PATH
{{ end -}}

# Every machine signs unattended commits with its own ed25519 key.
MACHINE_KEY="$HOME/.ssh/id_ed25519"
identity_changed=false
if { [ -f "$MACHINE_KEY" ] && [ ! -f "$MACHINE_KEY.pub" ]; } ||
	{ [ ! -f "$MACHINE_KEY" ] && [ -f "$MACHINE_KEY.pub" ]; }; then
	echo "error: incomplete machine key pair at $MACHINE_KEY" >&2
	exit 1
fi
if [ ! -f "$MACHINE_KEY" ]; then
	echo '>generating per-machine ed25519 key'
	ssh-keygen -t ed25519 -C "$(hostname -s) $(date +%F)" -f "$MACHINE_KEY"
	identity_changed=true
fi

signing_keys_to_add=("$MACHINE_KEY.pub")
auth_keys_to_add=()
{{ if and .desktop (eq .chezmoi.hostname "x1") -}}
auth_keys_to_add+=("$MACHINE_KEY.pub")
{{ end -}}

{{ if .desktop -}}
# FIDO2 resident key on the YubiKey. ssh-keygen -K downloads it from the
# authenticator into an id_ed25519_sk_rk* pair in the current directory.
SK_KEY="$HOME/.ssh/id_ed25519_sk"
if { [ -f "$SK_KEY" ] && [ ! -f "$SK_KEY.pub" ]; } ||
	{ [ ! -f "$SK_KEY" ] && [ -f "$SK_KEY.pub" ]; }; then
	echo "error: incomplete resident key pair at $SK_KEY" >&2
	exit 1
fi
if [ ! -f "$SK_KEY" ]; then
	echo '>downloading the resident key from the YubiKey (touch it when it blinks)'
	sk_tmp="$(mktemp -d)"
	( cd "$sk_tmp" && ssh-keygen -K )
	sk_keys=()
	for candidate in "$sk_tmp"/id_ed25519_sk_rk*; do
		[ -f "$candidate" ] || continue
		[[ "$candidate" == *.pub ]] && continue
		[ -f "$candidate.pub" ] && sk_keys+=("$candidate")
	done
	if [ "${#sk_keys[@]}" -ne 1 ]; then
		echo "error: expected one resident key pair in $sk_tmp, found ${#sk_keys[@]}" >&2
		rm -rf "$sk_tmp"
		exit 1
	fi
	downloaded_key="$(awk '{print $1, $2}' "${sk_keys[0]}.pub")"
	if ! is_approved_yubikey "$downloaded_key"; then
		echo 'error: downloaded resident key is not one of the approved YubiKeys' >&2
		rm -rf "$sk_tmp"
		exit 1
	fi
	mv "${sk_keys[0]}" "$SK_KEY"
	mv "${sk_keys[0]}.pub" "$SK_KEY.pub"
	rm -rf "$sk_tmp"
	ssh-add -K
	identity_changed=true
fi
sk_key="$(awk '{print $1, $2}' "$SK_KEY.pub")"
if ! is_approved_yubikey "$sk_key"; then
	echo 'error: resident key is not one of the approved YubiKeys' >&2
	exit 1
fi
signing_keys_to_add+=("$SK_KEY.pub")
auth_keys_to_add+=("$SK_KEY.pub")
{{ end -}}

# Key registrations are public, so check them before touching gh auth:
# re-runs skip the browser flow when nothing needs uploading. Buffering
# the JSON avoids curl|grep SIGPIPE false negatives under pipefail.
if ! registered_auth_keys="$(curl -fsS "https://api.github.com/users/${GH_ACCOUNT}/keys")" ||
	! registered_signing_keys="$(curl -fsS "https://api.github.com/users/${GH_ACCOUNT}/ssh_signing_keys")"; then
	if [ "$identity_changed" = true ]; then
		echo 'error: GitHub API unavailable; newly provisioned keys require registration' >&2
		exit 1
	fi
	echo '>ssh identity: GitHub API unavailable; skipped key registration' >&2
	exit 0
fi

needs_registration=false
for public_key in "${auth_keys_to_add[@]}"; do
	key_material="$(awk '{print $1, $2}' "$public_key")"
	grep -qF "$key_material" <<<"$registered_auth_keys" || needs_registration=true
done
for public_key in "${signing_keys_to_add[@]}"; do
	key_material="$(awk '{print $1, $2}' "$public_key")"
	grep -qF "$key_material" <<<"$registered_signing_keys" || needs_registration=true
done
if [ "$needs_registration" = false ]; then
	echo '>public keys already on GitHub'
	exit 0
fi

# gh may hold several accounts (work + personal): make $GH_ACCOUNT
# active so refresh and add never hit another login.
if gh auth switch --hostname github.com --user "$GH_ACCOUNT" 2>/dev/null; then
	echo ">using GitHub account ${GH_ACCOUNT}"
else
	echo ">logging in to GitHub as ${GH_ACCOUNT} (select this account in the browser)"
	gh auth login --hostname github.com --git-protocol https --web \
		--scopes admin:public_key --scopes admin:ssh_signing_key --skip-ssh-key
fi
active="$(gh api user -q .login)"
if [ "$active" != "$GH_ACCOUNT" ]; then
	echo "error: active GitHub account is not ${GH_ACCOUNT}" >&2
	exit 1
fi

# Login requests both scopes, so a token created by this script has
# public_key iff it has the signing scope; only older tokens need
# topping up.
if ! grep -qF admin:ssh_signing_key \
	<<<"$(gh auth status --hostname github.com --active 2>&1)"; then
	echo '>extending GitHub token scopes'
	gh auth refresh --hostname github.com \
		--scopes admin:public_key --scopes admin:ssh_signing_key
fi

for public_key in "${auth_keys_to_add[@]}"; do
	key_material="$(awk '{print $1, $2}' "$public_key")"
	if ! grep -qF "$key_material" <<<"$registered_auth_keys"; then
		echo '>registering key on GitHub as an authentication key'
		gh ssh-key add "$public_key" --title "$(whoami)@$(hostname -s)-$(basename "$public_key" .pub)"
	fi
done
for public_key in "${signing_keys_to_add[@]}"; do
	key_material="$(awk '{print $1, $2}' "$public_key")"
	if ! grep -qF "$key_material" <<<"$registered_signing_keys"; then
		echo '>registering key on GitHub as a signing key'
		gh ssh-key add "$public_key" --title "$(whoami)@$(hostname -s)-$(basename "$public_key" .pub)" --type signing
	fi
done
