#!/usr/bin/env bash
# vi: set ft=bash
set -euo pipefail

{{ if eq .chezmoi.os "darwin" -}}
# macOS ships Bash 3.2, which is too old for the interactive config.
# install-macos-packages sorts first and installs this binary.
bash_path="/opt/homebrew/bin/bash"
if [ ! -x "$bash_path" ]; then
	echo "Homebrew Bash is not installed at $bash_path" >&2
	exit 1
fi
{{ else -}}
bash_path="/bin/bash"
{{ end -}}
if ! grep --quiet --line-regexp --fixed-strings "$bash_path" /etc/shells; then
	echo "$bash_path" | sudo tee -a /etc/shells
fi
if [ "$SHELL" != "$bash_path" ]; then
	# chsh needs a PAM-capable tty. A non-interactive apply has none.
	if [ ! -t 0 ]; then
		echo "cannot change login shell to $bash_path: no tty for chsh" >&2
		exit 1
	fi
	chsh -s "$bash_path"
fi
