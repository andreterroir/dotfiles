{{ if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
# vi: set ft=bash
# A Mac already has Homebrew, so install only what this repository needs
# rather than reinstating a managed bundle: the Amp CLI and app, plus gh and
# jq, which the signing scripts call to register keys and derive the
# allowlist.
set -euo pipefail

require_brew() {
	if ! command -v brew >/dev/null 2>&1; then
		echo "error: Homebrew is required to install $1; install it and run chezmoi apply" >&2
		exit 1
	fi
}

{{ if not .transient -}}
missing=()
command -v gh >/dev/null 2>&1 || missing+=(gh)
command -v jq >/dev/null 2>&1 || missing+=(jq)
if [ "${#missing[@]}" -gt 0 ]; then
	require_brew "${missing[*]}"
	echo ">installing ${missing[*]} with Homebrew"
	HOMEBREW_NO_AUTO_UPDATE=1 brew install "${missing[@]}"
fi

{{ end -}}
# The official installer, as on Linux, links amp into ~/.local/bin. An amp
# already on PATH, such as an earlier Homebrew install, is kept.
if ! command -v amp >/dev/null 2>&1 && [ ! -x "$HOME/.local/bin/amp" ]; then
	echo '>installing amp'
	curl -fsSL https://ampcode.com/install.sh | bash
fi

if [ ! -d /Applications/Amp.app ]; then
	if [ "$(uname -m)" != arm64 ] || [ "$(sw_vers -productVersion | cut -d. -f1)" -lt 26 ]; then
		echo '>Amp app: needs Apple silicon and macOS 26 or later; skipping' >&2
	else
		require_brew amp-app
		echo '>installing the Amp app with Homebrew'
		HOMEBREW_NO_AUTO_UPDATE=1 brew install --cask amp-app
	fi
fi
{{ end -}}
