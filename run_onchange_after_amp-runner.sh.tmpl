{{ if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
# vi: set ft=bash
# Enable the Amp runner; it starts with the next boot or login.
set -euo pipefail

amp="$HOME/.local/bin/amp"

if [ ! -x "$amp" ]; then
	echo '>amp-runner: amp is not installed; skipping' >&2
	exit 0
fi

loginctl enable-linger "$(id -un)" >/dev/null 2>&1 || true

# Enabled, not started: the runner comes up with the next boot or login.
if ! enable_output="$(systemctl --user enable amp-runner.service 2>&1)"; then
	echo '>amp-runner: no systemd user manager; enable the runner by hand in a session' >&2
	exit 0
fi
# systemctl succeeds without enabling when the unit has no [Install] section.
[ -z "$enable_output" ] || printf '%s\n' "$enable_output" >&2
{{ end -}}
