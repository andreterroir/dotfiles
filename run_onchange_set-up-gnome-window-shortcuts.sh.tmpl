#!/usr/bin/env bash
# vi: set ft=bash
set -euo pipefail

wm=org.gnome.desktop.wm.keybindings
mk=org.gnome.mutter.keybindings

# Edit a key's chord list in place: add appends what is missing, drop removes
# what is listed, and every other chord survives.
chords() {
	local op="$1" schema="$2" key="$3"
	shift 3
	python3 - "$op" "$schema" "$key" "$@" <<'PY'
import ast
import subprocess
import sys

op, schema, key, wanted = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4:]
current = subprocess.run(
    ["gsettings", "get", schema, key],
    check=True,
    capture_output=True,
    text=True,
).stdout.strip()
value = ast.literal_eval(current.removeprefix("@as "))
if op == "add":
    value += [chord for chord in wanted if chord not in value]
else:
    value = [chord for chord in value if chord not in wanted]
subprocess.run(
    ["gsettings", "set", schema, key, "[" + ", ".join(f"'{c}'" for c in value) + "]"],
    check=True,
)
PY
}

# Rectangle's Control+Command chords become Control+Super, the home-row letter
# carrying the muscle memory over.
chords add "$mk" toggle-tiled-left '<Control><Super>h'
chords add "$mk" toggle-tiled-right '<Control><Super>l'
chords add "$wm" move-to-center '<Control><Super>j' '<Control><Super>m'
chords add "$wm" maximize '<Control><Super>k'
chords add "$wm" unmaximize '<Control><Super>u'

# Cmd+M minimizes, so the message tray hands Super+M over and keeps Super+V.
chords drop org.gnome.shell.keybindings toggle-message-tray '<Super>m'
chords add "$wm" minimize '<Super>m'

chords add "$wm" toggle-fullscreen '<Control><Super>f'
