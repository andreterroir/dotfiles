{{ if and (not .transient) (not .vm) -}}
#!/usr/bin/env bash
# vi: set ft=bash
set -euo pipefail

# Password sudo stays, but one entry covers a longer stretch of an apply.
policy="/etc/sudoers.d/99-chezmoi-timestamp"
candidate="$(mktemp)"
trap 'rm -f "$candidate"' EXIT
# Minutes; upstream sudo prompts again after 5 by default.
printf 'Defaults timestamp_timeout=90\n' > "$candidate"

# A dot makes sudo ignore the staging file until the validated rename.
sudo install -o root -g root -m 0440 "$candidate" "$policy.tmp"
sudo visudo -cf "$policy.tmp"
sudo mv -f "$policy.tmp" "$policy"
{{ end -}}
