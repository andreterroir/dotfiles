[user]
	name = André Terroir
	email = {{ .gitEmail }}
	signingKey = "{{ .chezmoi.homeDir }}/.ssh/id_ed25519"
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.allowed_signers
[commit]
	verbose = true
	gpgsign = true
[core]
	excludesfile = ~/.gitignore
	# keep the commit message when a commit fails (e.g. a missing signing key)
	editor = {{ .chezmoi.homeDir }}/.bin/git-editor
[init]
        defaultBranch = main
[pull]
	ff = only
[push]
        autoSetupRemote = true
[mergetool "vim"]
	cmd = vim -c "Gvdiffsplit!" "$MERGED"
	prompt = false
	keepBackup = false
[merge]
	tool = vim
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[alias]
	df = "diff --color-words"
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://ampcode.com/"]
	helper =
	helper = !amp git-credential-helper
[include]
	path = ~/.gitconfig.local
