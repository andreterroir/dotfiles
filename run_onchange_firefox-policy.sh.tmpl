{{- $asset := ternary "assets/firefox-policies-vm.json" "assets/firefox-policies.json" .vm -}}
{{ if eq .chezmoi.os "linux" -}}
{{   if and (eq .distro "fedora") .desktop -}}
#!/usr/bin/env bash
# vi: set ft=bash
# A system policy survives Firefox RPM updates, because no RPM owns it.
# {{ include $asset | sha256sum }}
set -euo pipefail

policy=/etc/firefox/policies/policies.json
source_file="$CHEZMOI_SOURCE_DIR/{{ $asset }}"

if [ -r "$policy" ] && cmp -s "$source_file" "$policy"; then
	echo '>firefox policy already installed'
	exit 0
fi

sudo install -D -m 0644 "$source_file" "$policy"
echo '>firefox policy installed'
{{   end -}}
{{ end -}}
