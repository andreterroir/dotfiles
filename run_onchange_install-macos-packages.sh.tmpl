{{ if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
# vi: set ft=bash
set -euo pipefail

if ! command -v brew > /dev/null; then
	/bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
	eval "$(/opt/homebrew/bin/brew shellenv)"
fi

brew bundle --file=/dev/stdin <<EOF

tap 'ampcode/tap'
tap 'anomalyco/tap'
tap 'cormacrelf/tap'

# Homebrew 6 refuses to load third-party formulae until they are trusted.
# Trust the formula, not the tap, so other formulae in the tap stay untrusted.
brew 'ampcode/tap/ampcode', trusted: true
brew 'ascii'
brew 'bash'
# @2 is the Bash 4.2+ completion package. Unversioned bash-completion
# is for macOS Bash 3.2 and conflicts with this formula.
brew 'bash-completion@2'
brew 'chezmoi'
brew 'coreutils'
brew 'cormacrelf/tap/dark-notify', trusted: true
brew 'delve'
brew 'fd'
brew 'fish'
brew 'fzf'
brew 'gh'
brew 'git'
brew 'git-gui'
brew 'git-lfs'
brew 'gnu-sed'
brew 'gnupg'
brew 'go'
brew 'golangci-lint'
brew 'hugo'
brew 'jq'
brew 'litecli'
brew 'mas'
brew 'mise'
brew 'neovim'
brew 'node'
brew 'npm'
brew 'anomalyco/tap/opencode', trusted: true
brew 'openjdk'
brew 'pass'
brew 'pass-otp'
brew 'pinentry-mac'
brew 'ripgrep'
brew 'shellcheck'
brew 'staticcheck'
brew 'tlrc'
brew 'tmux'
brew 'topgrade'
brew 'tpm'
brew 'tree'
brew 'tree-sitter'
brew 'uv'
brew 'watchexec'
brew 'wget'
brew 'ykman'
brew 'yubico-piv-tool'

cask 'amp-app'
cask 'appcleaner'
cask 'font-jetbrains-mono'
cask 'ghostty'
cask 'logi-options+'
cask 'meld'
cask 'netnewswire'
cask 'obsidian'
cask 'rectangle'
cask 'signal'
cask 'spotify'
cask 'sublime-text'
cask 'vlc'
cask 'zotero'

mas 'DaisyDisk', id: 411643860
mas 'DuckDuckGo', id: 663592361
mas 'Telegram', id: 747648890
mas 'WhatsApp', id: 310633997

EOF

{{ end }}
